FUNCTION_BLOCK "FB_VacuumCIP"
VAR_INPUT
    CIPMode             : Bool;
    TankFull100         : Bool;
    ResetSequence       : Bool;
    TankFullDelay       : Time;
    PumpPreOpenDelay    : Time;
    ValveOpenTime       : Time;
    PumpPostRunTime     : Time;
END_VAR
VAR_IN_OUT
    S                   : "UDT_CIP";
END_VAR
VAR_OUTPUT
    VacuumPumpCmd       : Bool;
    Valve212Cmd         : Bool;
END_VAR
VAR
    tTankFull           : TON;
    tPreOpen            : TON;
    tValveOpen          : TON;
    tPostRun            : TON;
    tStepElapsed        : TON;
    StepMemory          : USInt;
    MediumMemory        : USInt;
    TimerReset          : Bool;
END_VAR
BEGIN
    VacuumPumpCmd := FALSE;
    Valve212Cmd := FALSE;
    S.Active := CIPMode;

    TimerReset := (S.Step <> StepMemory) OR (S.Medium <> MediumMemory);
    tStepElapsed(IN := CIPMode AND NOT TimerReset, PT := T#24h);
    StepMemory := S.Step;
    MediumMemory := S.Medium;
    S.ElapsedTime := tStepElapsed.ET;

    tTankFull(IN := CIPMode AND (S.Step = USINT#10), PT := TankFullDelay);
    tPreOpen(IN := CIPMode AND (S.Step = USINT#20), PT := PumpPreOpenDelay);
    tValveOpen(IN := CIPMode AND (S.Step = USINT#30), PT := ValveOpenTime);
    tPostRun(IN := CIPMode AND (S.Step = USINT#40), PT := PumpPostRunTime);

    IF ResetSequence OR NOT CIPMode THEN
        S.Step := USINT#0;
        S.VacuumSequenceDone := FALSE;
        S.ElapsedTime := T#0ms;
    ELSE
        CASE S.Step OF
            USINT#0: // Circulation; wait for the full-tank trigger.
                IF TankFull100 THEN S.Step := USINT#10; END_IF;

            USINT#10: // Tank full confirmation delay (nominal 4 s).
                IF tTankFull.Q THEN S.Step := USINT#20; END_IF;

            USINT#20: // Start vacuum pump, keep valve closed for 1 s.
                VacuumPumpCmd := TRUE;
                IF tPreOpen.Q THEN S.Step := USINT#30; END_IF;

            USINT#30: // Valve 212 open for the configured 7 s.
                VacuumPumpCmd := TRUE;
                Valve212Cmd := TRUE;
                IF tValveOpen.Q THEN S.Step := USINT#40; END_IF;

            USINT#40: // Valve closed; vacuum pump post-run (10 s).
                VacuumPumpCmd := TRUE;
                IF tPostRun.Q THEN S.Step := USINT#50; END_IF;

            USINT#50:
                S.VacuumSequenceDone := TRUE;

        ELSE
            S.Step := USINT#0;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK
