FUNCTION_BLOCK "FB_HeightMode"
VAR_INPUT
    EnableFromHMI      : Bool;
    OtherHeightActive  : Bool;
    MachineStopped     : Bool;
    SafetyOK           : Bool;
    UpPB               : Bool;
    DownPB             : Bool;
    LowLimit           : Bool;
    HighLimit          : Bool;
END_VAR
VAR_OUTPUT
    HeightModeActive   : Bool;
    UpCmd              : Bool;
    DownCmd            : Bool;
    RotationBlock      : Bool;
    DirectionConflict  : Bool;
END_VAR

BEGIN
    HeightModeActive := EnableFromHMI
                        AND NOT OtherHeightActive
                        AND MachineStopped
                        AND SafetyOK;

    RotationBlock := HeightModeActive;
    DirectionConflict := UpPB AND DownPB;

    UpCmd := HeightModeActive
             AND UpPB
             AND NOT DownPB
             AND NOT HighLimit;

    DownCmd := HeightModeActive
               AND DownPB
               AND NOT UpPB
               AND NOT LowLimit;
END_FUNCTION_BLOCK
