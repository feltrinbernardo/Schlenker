END_TYPE

TYPE "UDT_CIPRecipeStep" :
STRUCT
    Enabled             : Bool;
    Medium              : USInt; // 0 OFF, 1 cold, 2 hot, 3 caustic/acid, 4 citra, 5 discharge
    Duration            : Time;
    AdvanceMode         : USInt; // 0 AUTO, 1 MANUAL NEXT
END_STRUCT;
END_TYPE

TYPE "UDT_CIPRecipe" :
STRUCT
    RecipeName          : String[32];
    Revision            : UInt;
    StepCount           : USInt;
    Valid               : Bool; // calculated by the PLC recipe engine
    LifecycleState      : USInt; // 0 DRAFT, 1 APPROVED, 2 LOCKED, 3 SUPERSEDED
    Approved            : Bool;
    Locked              : Bool;
    OperatorSelectable  : Bool;
    LastModifiedBy      : String[32];
    ApprovedBy          : String[32];
    LockedBy            : String[32];
    LastModifiedAt      : DTL;
    ApprovedAt          : DTL;
    LockedAt            : DTL;
    Step                : Array[1..10] of "UDT_CIPRecipeStep";
END_STRUCT;
END_TYPE

TYPE "UDT_CIPRecipeControl" :
STRUCT
    Initialized         : Bool;
    EngineeringAuthorized : Bool; // HMI session-derived engineering permit
    ActorName           : String[32];
    ActorRole           : USInt; // 0 unknown/operator, 1 maintenance, 2 engineer, 3 administrator
    DraftValidationCode : UInt;
    ApprovedValidationCode : UInt;
    StartPermitted      : Bool;
    StartRejectedInvalid : Bool;
    StartRejectedUnapproved : Bool;
    StartRejectedUnlocked : Bool;
    EditRejected        : Bool;
    ActiveSnapshotReady : Bool;
    ActiveRecipeName    : String[32];
    ActiveRecipeRevision : UInt;
    AuditHead           : USInt;
    AuditCount          : USInt;
    AuditSequence       : UDInt;
    LastAuditTimestamp  : DTL;
    LastAuditTimestampValid : Bool;
    LastAuditActorName  : String[32];
    LastAuditAction     : USInt;
    LastAuditStep       : USInt;
    ExecutionHead       : USInt;
    ExecutionCount      : USInt;
    ExecutionSequence   : UDInt;
    LastExecutionRunId  : UDInt;
    LastExecutionResult : USInt;
    LastExecutionRecipe : String[32];
    LastExecutionRevision : UInt;
END_STRUCT;
END_TYPE

TYPE "UDT_CIPRecipeAuditEntry" :
STRUCT
    Sequence            : UDInt;
    Timestamp           : DTL;
    TimestampValid      : Bool;
    ActorName           : String[32];
    ActorRole           : USInt;
    RecipeName          : String[32];
    Revision            : UInt;
    Action              : USInt; // 1 create, 2 save, 3 approve, 4 lock, 5 supersede, 6 start, 7 manual next, 8 enable, 9 disable, 10 medium, 11 duration, 12 advance mode
    StepNumber          : USInt;
    OldValue            : DInt;
    NewValue            : DInt;
END_STRUCT;
END_TYPE

TYPE "UDT_CIPExecutionRecord" :
STRUCT
    RunId               : UDInt;
    StartTimestamp      : DTL;
    FinishTimestamp     : DTL;
    StartTimestampValid : Bool;
    FinishTimestampValid : Bool;
    OperatorName        : String[32];
    RecipeName          : String[32];
    RecipeRevision      : UInt;
    Result              : USInt; // 0 running, 1 completed, 2 aborted, 3 faulted
    FinalStep           : USInt;
    ManualNextCount     : USInt;
    FaultCode           : UInt;
    StepMedium          : Array[1..10] of USInt;
    StepProgrammedDuration : Array[1..10] of Time;
    StepActualDuration  : Array[1..10] of Time;
    StepAdvanceMode     : Array[1..10] of USInt;
    StepCompleted       : Array[1..10] of Bool;
END_STRUCT;
END_TYPE

