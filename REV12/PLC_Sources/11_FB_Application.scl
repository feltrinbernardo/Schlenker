FUNCTION_BLOCK "FB_Application"
VAR
    StateManager        : "FB_MainState";
    ProductPump         : "FB_ProductPump";
    AccumGate           : "FB_AccumulationGate";
    FillerHeight        : "FB_HeightMode";
    CapperHeight        : "FB_HeightMode";
    JogPendant          : "FB_JogPendant";
    ConveyorSync        : "FB_ConveyorSync";
    VacuumCIP           : "FB_VacuumCIP";
    ValveManager        : "FB_SMC_ValveManager";
    SmcDiagnostics      : "FB_SMC_DeviceDiagnostics";
    AL100Diagnostics    : "FB_ProfinetDeviceDiagnostics";
    AL101Diagnostics    : "FB_ProfinetDeviceDiagnostics";
    AL102Diagnostics    : "FB_ProfinetDeviceDiagnostics";
    AL103Diagnostics    : "FB_ProfinetDeviceDiagnostics";
    AL104Diagnostics    : "FB_ProfinetDeviceDiagnostics";
    Alarms              : "FB_AlarmManager";
    DoorAccess          : "FB_DoorAccess";
    ManualGate          : "FB_ManualValveOverride";
    Auxiliaries         : "FB_Auxiliaries";
    NetworkDiagnostics  : "FB_NetworkDiagnostics";
    ExternalBottleWash : "FB_ExternalBottleWash";
    AutoBottleGate      : "FB_AutoBottleGateRequest";
    RunOutProduct       : "FB_RunOutProduct";
    CIPMediaPump        : "FB_CIPMediaPump";
    ProductionVacuum    : "FB_ProductionVacuum";
    ProductCircuit      : "FB_ProductCircuitManager";
    LiftConfirmation    : "FB_LiftConfirmation";
    CIPSequence         : "FB_CIPSequence";
    CIPRecipeManager    : "FB_CIPRecipeManager";
    InternalWash        : "FB_InternalWash";
    OpenPointsSupervisor: "FB_OpenPointsSupervisor";
    EfficiencyPulse     : R_TRIG;
    HMIHeartbeatWatchdog: TON;
    HMIHeartbeatLast    : DInt;
    HMIHeartbeatChanged : Bool;
    HMIHeartbeatSeen    : Bool;
    MainDriveJamArmTimer : TON;
    MainDriveJamTripTimer : TON;
    MainDriveJamArmed    : Bool;
    MainDriveJamCondition: Bool;
    MainDriveJamCommandHz: Real;

    FillerActive        : Bool;
    CapperActive        : Bool;
    GateOpenCmd         : Bool;
    GateCloseCmd        : Bool;
    StandbyRequest      : Bool;
    SpeedLimitPct       : Real;
    GateFault           : Bool;
    PumpLevelFault      : Bool;
    PumpLowWarning      : Bool;
    SMCConflict         : Bool;
    SMCProfinetOK       : Bool;
    SMCDiagnosticRetVal : Int;
    AL100ProfinetOK     : Bool;
    AL101ProfinetOK     : Bool;
    AL102ProfinetOK     : Bool;
    AL103ProfinetOK     : Bool;
    AL104ProfinetOK     : Bool;
    AL100DiagnosticRetVal : Int;
    AL101DiagnosticRetVal : Int;
    AL102DiagnosticRetVal : Int;
    AL103DiagnosticRetVal : Int;
    AL104DiagnosticRetVal : Int;
    ManualSMCTestActive : Bool;
    SMCProductInletCmd  : Bool;
    SMCProductCloseCmd  : Bool;
    SMCEV210Cmd         : Bool;
    SMCEV211Cmd         : Bool;
    SMCEV212Cmd         : Bool;
    SMCCapDistributorCmd: Bool;
    SMCCapChannelCmd    : Bool;
    SMCBottleWashCmd    : Bool;
    DrivesReady         : Bool;
    MachineStopped      : Bool;
    JogSpeedPct         : Real;
    GateFinalOpenCmd    : Bool;
    GateFinalCloseCmd   : Bool;
    ManualGateActive    : Bool;
    SpeedParameterFault : Bool;
    EffectiveCmd        : "UDT_Command";
    ProductPumpEnableCmd: Bool;
    ProductPumpEmptying : Bool;
    CIPVacuumPumpCmd    : Bool;
    VacuumPumpBenchPermit : Bool;
    ConveyorBenchPermit : Bool;
    CapDriveBenchPermit : Bool;
    CIPValve212Cmd      : Bool;
    ProductionMediaReady : Bool;
    BottleShortage1Alarm : Bool;
    BottleShortage2Alarm : Bool;
    Accumulation1Alarm   : Bool;
    Accumulation2Alarm   : Bool;
    ProductionDriveDemand : Bool;
    AutomaticMainSpeedPct : Real;
    ConveyorRunRequest    : Bool;
    ConveyorSpeedRequestPct : Real;
    ConveyorMainStartPermit : Bool;
    ConveyorRunOnActive  : Bool;
    ConveyorSyncActive   : Bool;
    BenchMainSpeedPct    : Real;
    JogTrackingValid     : Bool;
    MainDriveStatusWord  : Word;
    ConveyorStatusWord   : Word;
    ProductPumpStatusWord: Word;
    CapDriveStatusWord   : Word;
    LMT100ProcessData    : Word;
    MainDriveControlWord : Word;
    ConveyorControlWord  : Word;
    ProductPumpControlWord : Word;
    CapDriveControlWord  : Word;
    MainSpeedRaw         : Int;
    ConveyorSpeedRaw     : Int;
    ProductPumpSpeedRaw  : Int;
    CapDriveSpeedRaw     : Int;
END_VAR

BEGIN
    // Definitive integrated-I/O baseline for the CPU DI/DQ terminals. This map
    // is the electrical-design source for the future cabinet and the present
    // PLC terminal/LED tests. Do not reassign an address without revising the
    // master I/O schedule and electrical drawings.
    "DB_Global".Inp.SafetyOK := %I10.0;
    "DB_Global".Inp.AirPressureOK := %I10.1;
    "DB_Global".Inp.EncoderHealthy := %I10.2;
    "DB_Global".Inp.MachineZero := %I10.3;
    "DB_Global".Inp.BottleInfeed := %I10.4;
    "DB_Global".Inp.TankFull100 := %I10.5;
    "DB_Global".Inp.BottleShortage1 := %I10.6;
    "DB_Global".Inp.BottleShortage2 := %I10.7;
    "DB_Global".Inp.Accumulation1 := %I11.0;
    "DB_Global".Inp.Accumulation2 := %I11.1;
    "DB_Global".Inp.GateOpenFB := %I11.2;
    "DB_Global".Inp.GateClosedFB := %I11.3;
    "DB_Global".Inp.FillerLowLimit := %I11.4;
    "DB_Global".Inp.FillerHighLimit := %I11.5;
    "DB_Global".Inp.CapperLowLimit := %I11.6;
    "DB_Global".Inp.CapperHighLimit := %I11.7;
    "DB_Global".Inp.CapPresent := %I12.0;
    "DB_Global".Inp.CapHopperLow := %I12.1;
    "DB_Global".Inp.CapChannelDemand := %I12.2;
    "DB_Global".Inp.CapsMissing := %I12.3;
    "DB_Global".Inp.HoodFilterAlarm := %I12.4;
    "DB_Global".Inp.ControlPowerOK := %I12.5;
    "DB_Global".Inp.AirFilterPressureOK := %I12.6;
    "DB_Global".Inp.AirFilterChangeRequired24V := %I12.7;
    "DB_Global".Inp.RequestOpenDoorPanelPB := %I13.0;
    "DB_Global".Inp.RequestOpenDoorFrontPB := %I13.1;
    "DB_Global".Inp.RequestOpenDoorRearPB := %I13.2;
    "DB_Global".Inp.ControlledStopComplete := %I13.3;
    "DB_Global".Inp.ZeroSpeedConfirmed := %I13.4;
    "DB_Global".Inp.ThreePhaseOffConfirmed := %I13.5;
    "DB_Global".Inp.AllDoorsClosed := %I13.6;
    "DB_Global".Inp.ResetAlarmPanelPB := %I13.7;

    // HMI communication supervision. The Unified runtime increments the
    // heartbeat every 500 ms. A frozen value for 3 s removes the link flag;
    // the flag is never forced TRUE merely because the panel is reachable.
    HMIHeartbeatChanged :=
        "DB_Global".Inp.HMIHeartbeat <> HMIHeartbeatLast;
    IF HMIHeartbeatChanged THEN
        HMIHeartbeatLast := "DB_Global".Inp.HMIHeartbeat;
        HMIHeartbeatSeen := TRUE;
    END_IF;
    HMIHeartbeatWatchdog(
        IN := NOT HMIHeartbeatChanged,
        PT := T#3s
    );
    "DB_Global".Inp.HMILinkOK :=
        HMIHeartbeatSeen AND NOT HMIHeartbeatWatchdog.Q;

    // G120C Standard telegram 1 input image. The four device and byte ranges
    // are fixed in the compiled hardware configuration on PN/IE_1.
    MainDriveStatusWord := %IW308;
    ConveyorStatusWord := %IW312;
    ProductPumpStatusWord := %IW316;
    CapDriveStatusWord := %IW320;

    // SPL100 / IFM LMT100 on AL103 port 1. The IODD defines a 16-bit
    // process-data input with OUT1 at bit 0, OUT2 at bit 1 and the measured
    // level at bits 2..15. The hardware tag is bound to the two-byte input
    // submodule assigned to AL103/P1; no inferred absolute address is used.
    LMT100ProcessData := "SPL100_LMT100_ProcessData";
    "DB_Global".Inp.ProductPresentAtPump := LMT100ProcessData.%X0;

    "DB_Global".Inp.MainDriveReady :=
        MainDriveStatusWord.%X0 OR MainDriveStatusWord.%X1;
    "DB_Global".Inp.MainDriveFault := MainDriveStatusWord.%X3;
    "DB_Global".Inp.MainDriveRunning := MainDriveStatusWord.%X2;
    "DB_Global".Inp.MainDriveFeedbackValid := MainDriveStatusWord <> WORD#0;
    "DB_Global".Inp.ConveyorReady :=
        ConveyorStatusWord.%X0 OR ConveyorStatusWord.%X1;
    "DB_Global".Inp.ConveyorFault := ConveyorStatusWord.%X3;
    "DB_Global".Inp.ConveyorRunning := ConveyorStatusWord.%X2;
    "DB_Global".Inp.ConveyorFeedbackValid := ConveyorStatusWord <> WORD#0;
    "DB_Global".Inp.ProductPumpReady :=
        ProductPumpStatusWord.%X0 OR ProductPumpStatusWord.%X1;
    "DB_Global".Inp.ProductPumpFault := ProductPumpStatusWord.%X3;
    "DB_Global".Inp.ProductPumpRunning := ProductPumpStatusWord.%X2;
    "DB_Global".Inp.ProductPumpFeedbackValid := ProductPumpStatusWord <> WORD#0;
    "DB_Global".Inp.CapDriveReady :=
        CapDriveStatusWord.%X0 OR CapDriveStatusWord.%X1;
    "DB_Global".Inp.CapDriveFault := CapDriveStatusWord.%X3;
    "DB_Global".Inp.CapDriveRunning := CapDriveStatusWord.%X2;
    "DB_Global".Inp.CapDriveFeedbackValid := CapDriveStatusWord <> WORD#0;
    "DB_Global".Inp.DriveG120CNetworkOK :=
        "DB_Global".Inp.MainDriveFeedbackValid
        AND "DB_Global".Inp.ConveyorFeedbackValid
        AND "DB_Global".Inp.ProductPumpFeedbackValid
        AND "DB_Global".Inp.CapDriveFeedbackValid;

    IF "DB_Global".Par.DriveBaseFrequencyHz > 0.0 THEN
        "DB_Global".Inp.MainDriveActualHz :=
            (INT_TO_REAL(WORD_TO_INT(%IW310)) / 16384.0) *
            "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Inp.ConveyorActualHz :=
            (INT_TO_REAL(WORD_TO_INT(%IW314)) / 16384.0) *
            "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Inp.ProductPumpActualHz :=
            (INT_TO_REAL(WORD_TO_INT(%IW318)) / 16384.0) *
            "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Inp.CapDriveActualHz :=
            (INT_TO_REAL(WORD_TO_INT(%IW322)) / 16384.0) *
            "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Inp.MainSpeedActualPct :=
            ("DB_Global".Inp.MainDriveActualHz /
             "DB_Global".Par.DriveBaseFrequencyHz) * 100.0;
        "DB_Global".Inp.MainSpeedActualValid :=
            "DB_Global".Inp.MainDriveFeedbackValid;
    ELSE
        "DB_Global".Inp.MainDriveActualHz := 0.0;
        "DB_Global".Inp.ConveyorActualHz := 0.0;
        "DB_Global".Inp.ProductPumpActualHz := 0.0;
        "DB_Global".Inp.CapDriveActualHz := 0.0;
        "DB_Global".Inp.MainSpeedActualPct := 0.0;
        "DB_Global".Inp.MainSpeedActualValid := FALSE;
    END_IF;

    // TEMPORARY BENCH COMMISSIONING ONLY.  The machine and physical safety
    // chain are not installed.  This flag is consumed only by the restricted
    // manual SMC valve-test path below and must be removed before site use.
    "DB_Global".SimulationMode := TRUE;
    SmcDiagnostics(
        ProfinetDeviceOK => SMCProfinetOK,
        DiagnosticRetVal => SMCDiagnosticRetVal
    );
    // Physical PROFINET diagnostics for the five configured IFM AL1403
    // masters. The system constants are generated by the TIA hardware
    // configuration; no absolute address or inferred process bit is used.
    AL100Diagnostics(
        DeviceLaddr := "al100~IODevice",
        DeviceOK => AL100ProfinetOK,
        DiagnosticRetVal => AL100DiagnosticRetVal
    );
    AL101Diagnostics(
        DeviceLaddr := "al101~IODevice",
        DeviceOK => AL101ProfinetOK,
        DiagnosticRetVal => AL101DiagnosticRetVal
    );
    AL102Diagnostics(
        DeviceLaddr := "al102~IODevice",
        DeviceOK => AL102ProfinetOK,
        DiagnosticRetVal => AL102DiagnosticRetVal
    );
    AL103Diagnostics(
        DeviceLaddr := "al103~IODevice",
        DeviceOK => AL103ProfinetOK,
        DiagnosticRetVal => AL103DiagnosticRetVal
    );
    AL104Diagnostics(
        DeviceLaddr := "al104~IODevice",
        DeviceOK => AL104ProfinetOK,
        DiagnosticRetVal => AL104DiagnosticRetVal
    );
    "DB_Global".Inp.IOLinkMaster1OK := AL100ProfinetOK;
    "DB_Global".Inp.IOLinkMaster2OK := AL101ProfinetOK;
    "DB_Global".Inp.IOLinkMaster3OK := AL102ProfinetOK;
    "DB_Global".Inp.IOLinkMaster4OK := AL103ProfinetOK;
    // AL104 is present in the approved TIA hardware configuration. Its
    // unproven port/process mapping remains a separate configuration item.
    "DB_Global".Inp.IOLinkMaster5Configured := TRUE;
    "DB_Global".Inp.IOLinkMaster5OK := AL104ProfinetOK;
    "DB_Global".Inp.AnybusGatewayOK := SMCProfinetOK;
    // The configured Anybus output module reports its device/module problem
    // state through PROFINET diagnostics. Separate EtherCAT/manifold status
    // remains unclaimed until a verified diagnostic source is mapped.
    // TEMPORARY BENCH COMMISSIONING ONLY: permit the momentary manual valve
    // test to write the configured output image even while the incomplete
    // gateway/manifold diagnostic chain is not yet proven.  The physical
    // gateway must still be present for a coil to energise.  Remove before
    // machine/site commissioning.
    "DB_Global".Inp.SMCCommOK := SMCProfinetOK OR "DB_Global".SimulationMode;

    // Live startup-safe checklist. This is deliberately based on commanded
    // outputs only. Physical de-energisation feedback remains a commissioning
    // hold point and is exposed separately to the HMI.
    "DB_Global".StartupSafeState.DrivesOff :=
        NOT "DB_Global".Out.MainRun AND
        NOT "DB_Global".Out.ConveyorRun AND
        NOT "DB_Global".Out.ProductPumpRun AND
        NOT "DB_Global".Out.CapDriveRun;
    "DB_Global".StartupSafeState.PumpsOff :=
        NOT "DB_Global".Out.ProductPumpRun AND
        NOT "DB_Global".Out.VacuumPump;
    "DB_Global".StartupSafeState.VentilationOff :=
        NOT "DB_Global".Out.AirFilterRelayCmd;
    "DB_Global".StartupSafeState.LightsOff :=
        NOT "DB_Global".Out.MachineLightsRelayCmd AND
        NOT "DB_Global".Out.RequestBlueLampCmd AND
        NOT "DB_Global".Out.RequestPanelBlueLampCmd AND
        NOT "DB_Global".Out.RequestFrontBlueLampCmd AND
        NOT "DB_Global".Out.RequestRearBlueLampCmd;
    "DB_Global".StartupSafeState.ProductInletOff :=
        NOT "DB_Global".Out.ProductionReqProduct;
    "DB_Global".StartupSafeState.BottleInletOff :=
        NOT "DB_Global".Out.GateOpen AND
        NOT "DB_Global".Out.GateClose;
    "DB_Global".StartupSafeState.WashOff :=
        NOT "DB_Global".Out.ExternalBottleWashValveCmd AND
        NOT "DB_Global".Out.FillerExternalWashValveCmd AND
        NOT "DB_Global".Out.InternalWashValveCmd;
    "DB_Global".StartupSafeState.ProcessValvesOff :=
        NOT "DB_Global".Out.EV210 AND
        NOT "DB_Global".Out.EV211 AND
        NOT "DB_Global".Out.EV212 AND
        NOT "DB_Global".Out.EV220 AND
        NOT "DB_Global".Out.EV221 AND
        NOT "DB_Global".Out.EV230FastRelease AND
        ("DB_Global".Out.ValveBits = DWORD#0) AND
        NOT "DB_Global".Out.Valve210Cmd AND
        NOT "DB_Global".Out.Valve217Cmd AND
        NOT "DB_Global".Out.Valve213Cmd AND
        NOT "DB_Global".Out.Valve212Cmd AND
        NOT "DB_Global".Out.Valve247Cmd;
    "DB_Global".StartupSafeState.CIPRequestsOff :=
        NOT "DB_Global".Out.CIPReqColdWater AND
        NOT "DB_Global".Out.CIPReqHotWater AND
        NOT "DB_Global".Out.CIPReqAcid AND
        NOT "DB_Global".Out.CIPReqCitra AND
        NOT "DB_Global".Out.CIPReqDischarge;
    "DB_Global".StartupSafeState.VerticalMotionOff :=
        NOT "DB_Global".Out.FillerUp AND
        NOT "DB_Global".Out.FillerDown AND
        NOT "DB_Global".Out.CapperUp AND
        NOT "DB_Global".Out.CapperDown;
    "DB_Global".StartupSafeState.DoorAndSignalsOff :=
        NOT "DB_Global".Out.UnlockAllDoorsRequest;
    "DB_Global".StartupSafeState.AllCommandsOff :=
        "DB_Global".StartupSafeState.DrivesOff AND
        "DB_Global".StartupSafeState.PumpsOff AND
        "DB_Global".StartupSafeState.VentilationOff AND
        "DB_Global".StartupSafeState.LightsOff AND
        "DB_Global".StartupSafeState.ProductInletOff AND
        "DB_Global".StartupSafeState.BottleInletOff AND
        "DB_Global".StartupSafeState.WashOff AND
        "DB_Global".StartupSafeState.ProcessValvesOff AND
        "DB_Global".StartupSafeState.CIPRequestsOff AND
        "DB_Global".StartupSafeState.VerticalMotionOff AND
        "DB_Global".StartupSafeState.DoorAndSignalsOff;
    "DB_Global".StartupSafeState.StartPermitted :=
        "DB_Global".StartupSafeState.AllCommandsOff;
    "DB_Global".StartupSafeState.PhysicalFeedbackComplete := FALSE;

    // Validate all HMI-adjustable process timings in the PLC. These are
    // process limits only; safety-certified timing remains outside this list.
    "DB_Global".Par.CIPTankFullDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPTankFullDelay, MX := T#10s);
    "DB_Global".Par.CIPPumpPreOpenDelay := LIMIT(MN := T#0s, IN := "DB_Global".Par.CIPPumpPreOpenDelay, MX := T#5s);
    "DB_Global".Par.CIPValve212OpenTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPValve212OpenTime, MX := T#20s);
    "DB_Global".Par.CIPVacuumPostRunTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPVacuumPostRunTime, MX := T#30s);
    "DB_Global".Par.CIPMediaLossDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPMediaLossDelay, MX := T#10s);
    "DB_Global".Par.VacuumStartupDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.VacuumStartupDelay, MX := T#15s);
    "DB_Global".Par.RunOutLastBottleDelay := LIMIT(MN := T#5s, IN := "DB_Global".Par.RunOutLastBottleDelay, MX := T#60s);
    "DB_Global".Par.ExternalWashOffDelay := LIMIT(MN := T#0s, IN := "DB_Global".Par.ExternalWashOffDelay, MX := T#10s);
    "DB_Global".Par.ConveyorBaseSpeedPct := LIMIT(MN := 0.0, IN := "DB_Global".Par.ConveyorBaseSpeedPct, MX := 100.0);
    "DB_Global".Par.ConveyorManualFrequencyHz :=
        LIMIT(MN := 5.0, IN := "DB_Global".Par.ConveyorManualFrequencyHz, MX := 15.0);
    "DB_Global".Par.ConveyorSpeedOffsetPct := LIMIT(MN := 0.0, IN := "DB_Global".Par.ConveyorSpeedOffsetPct, MX := 50.0);
    "DB_Global".Par.ConveyorPrestartTime := LIMIT(MN := T#0s, IN := "DB_Global".Par.ConveyorPrestartTime, MX := T#10s);
    "DB_Global".Par.ConveyorRunOnTime := LIMIT(MN := T#0s, IN := "DB_Global".Par.ConveyorRunOnTime, MX := T#60s);
    "DB_Global".Par.CIPColdWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPColdWashTime, MX := T#4h);
    "DB_Global".Par.CIPHotWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPHotWashTime, MX := T#4h);
    "DB_Global".Par.CIPAcidWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPAcidWashTime, MX := T#4h);
    "DB_Global".Par.CIPHotRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPHotRinseTime, MX := T#4h);
    "DB_Global".Par.CIPColdRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPColdRinseTime, MX := T#4h);
    "DB_Global".Par.CIPCitraTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPCitraTime, MX := T#4h);
    "DB_Global".Par.CIPFinalRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPFinalRinseTime, MX := T#4h);
    "DB_Global".Par.CIPDischargeTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPDischargeTime, MX := T#1h);
    "DB_Global".Par.CIPRemoteResponseTimeout := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPRemoteResponseTimeout, MX := T#5m);

    // REV11 network diagnostics are retained and executed before state control.
    NetworkDiagnostics(
        Pilz_DeviceOK := "DB_Global".Inp.PilzDeviceOK,
        IOLinkMaster1_OK := "DB_Global".Inp.IOLinkMaster1OK,
        IOLinkMaster2_OK := "DB_Global".Inp.IOLinkMaster2OK,
        IOLinkMaster3_OK := "DB_Global".Inp.IOLinkMaster3OK,
        IOLinkMaster4_OK := "DB_Global".Inp.IOLinkMaster4OK,
        IOLinkMaster5_Configured := "DB_Global".Inp.IOLinkMaster5Configured,
        IOLinkMaster5_OK := "DB_Global".Inp.IOLinkMaster5OK,
        Drive_G120C_OK := "DB_Global".Inp.DriveG120CNetworkOK,
        HMI_LinkOK := "DB_Global".Inp.HMILinkOK,
        AnybusGateway_OK := "DB_Global".Inp.AnybusGatewayOK,
        AnybusGateway_ECAT_OK := "DB_Global".Inp.AnybusGatewayECATOK,
        NetworkOK => "DB_Global".NetworkOK,
        FaultyDeviceMask => "DB_Global".FaultyDeviceMask
    );

    // Device readiness summary.
    DrivesReady :=
        "DB_Global".Inp.MainDriveReady AND
        "DB_Global".Inp.ConveyorReady AND
        ("DB_Global".Inp.ProductPumpReady OR NOT "DB_Global".Cmd.ProductPumpEnable) AND
        "DB_Global".Inp.CapDriveReady AND
        "DB_Global".OpenPoints.ReadyPermissives;

    MachineStopped := NOT "DB_Global".Out.MainRun;
    IF ("DB_Global".Par.MinSpeedBPH > 0.0)
       AND ("DB_Global".Par.MaxSpeedBPH >= "DB_Global".Par.MinSpeedBPH) THEN
        // Operator entries below the approved 3000 BPH floor are corrected
        // in the shared parameter so Unified displays the effective value.
        "DB_Global".Par.ProductionSpeedBPH :=
            LIMIT(MN := "DB_Global".Par.MinSpeedBPH,
                  IN := "DB_Global".Par.ProductionSpeedBPH,
                  MX := "DB_Global".Par.MaxSpeedBPH);
    END_IF;

    SpeedParameterFault := ("DB_Global".Par.MinSpeedBPH <= 0.0)
                           OR ("DB_Global".Par.MaxSpeedBPH < "DB_Global".Par.MinSpeedBPH)
                           OR ("DB_Global".Par.MainDriveMaxFrequencyHz <= 0.0)
                           OR ("DB_Global".Par.MainDriveMaxFrequencyHz > 65.0)
                           OR ("DB_Global".Par.DriveBaseFrequencyHz <= 0.0)
                           OR ("DB_Global".Par.MainJogMaxFrequencyHz < 0.0)
                           OR ("DB_Global".Par.MainJogMaxFrequencyHz > 15.0)
                           OR ("DB_Global".Par.ProductPumpManualMinHz < 15.0)
                           OR ("DB_Global".Par.ProductPumpManualMaxHz > 40.0)
                           OR ("DB_Global".Par.ProductPumpManualMinHz >
                               "DB_Global".Par.ProductPumpManualMaxHz);
    ProductionMediaReady := "DB_Global".Inp.ProductPresentAtPump
                            OR ("DB_Global".Inp.TankLevelPct >= "DB_Global".Par.ProductPumpStartMinLevelPct);
    "DB_Global".ProductLevelNotReached := NOT ProductionMediaReady;
    "DB_Global".CIPStartBlocked := "DB_Global".Cmd.CIPStart
                                   AND ("DB_Global".Machine.ProductionActive
                                        OR "DB_Global".Machine.RunOutActive);

    DoorAccess(
        RequestOpenDoorPanelPB := "DB_Global".Inp.RequestOpenDoorPanelPB,
        RequestOpenDoorFrontPB := "DB_Global".Inp.RequestOpenDoorFrontPB,
        RequestOpenDoorRearPB := "DB_Global".Inp.RequestOpenDoorRearPB,
        Blink1Hz := "DB_Global".Inp.Blink1Hz,
        MachineRunning := "DB_Global".Out.MainRun,
        ControlledStopComplete := "DB_Global".Inp.ControlledStopComplete,
        ZeroSpeedConfirmed := "DB_Global".Inp.ZeroSpeedConfirmed,
        ThreePhaseOffConfirmed := "DB_Global".Inp.ThreePhaseOffConfirmed,
        AllDoorsClosed := "DB_Global".Inp.AllDoorsClosed,
        AllDoorsUnlocked := "DB_Global".Inp.AllDoorsUnlocked,
        SafetyCircuitClosed := "DB_Global".Inp.SafetyCircuitClosed,
        SafetySystemFault := "DB_Global".Inp.SafetySystemFault,
        EStopChain24VHealthy := "DB_Global".Inp.EStopChain24VHealthy,
        AuxiliaryPanelPB := "DB_Global".Inp.AuxiliaryPanelPB,
        ResetAlarmPanelPB := "DB_Global".Inp.ResetAlarmPanelPB,
        ResetFault := "DB_Global".Cmd.Reset OR "DB_Global".Inp.ResetAlarmPanelPB,
        StopTimeout := "DB_Global".Par.DoorStopTimeout,
        PowerOffTimeout := "DB_Global".Par.DoorPowerOffTimeout,
        UnlockTimeout := "DB_Global".Par.DoorUnlockTimeout,
        D := "DB_Global".DoorAccess
    );

    // REV23: non-safety Pilz diagnostic view. These assignments do not alter
    // machine permissives or the validated Pilz safety authority. The current
    // TIA project contains no Pilz device/GSDML/process-image map, therefore
    // PhysicalMapConfigured remains FALSE and no absolute address is invented.
    "DB_Global".PilzDiag.CommunicationOK := "DB_Global".Inp.PilzDeviceOK;
    "DB_Global".PilzDiag.PhysicalMapConfigured := FALSE;
    "DB_Global".PilzDiag.DataValid := "DB_Global".PilzDiag.CommunicationOK
                                      AND "DB_Global".PilzDiag.PhysicalMapConfigured;
    IF "DB_Global".PilzDiag.DataValid THEN
        "DB_Global".PilzDiag.SafetyReady := "DB_Global".Inp.SafetyOK;
        "DB_Global".PilzDiag.GeneralFault := "DB_Global".Inp.SafetySystemFault;
        "DB_Global".PilzDiag.ResetRequired := "DB_Global".DoorAccess.AlarmResetRequired;
        "DB_Global".PilzDiag.EStopChainHealthy := "DB_Global".Inp.EStopChain24VHealthy;
        "DB_Global".PilzDiag.AllGuardsClosed := "DB_Global".Inp.AllDoorsClosed;
        "DB_Global".PilzDiag.AllGuardsUnlocked := "DB_Global".Inp.AllDoorsUnlocked;
        "DB_Global".PilzDiag.SafetyCircuitClosed := "DB_Global".Inp.SafetyCircuitClosed;
        "DB_Global".PilzDiag.StandstillConfirmed := "DB_Global".Inp.ZeroSpeedConfirmed;
        "DB_Global".PilzDiag.ThreePhaseOffConfirmed := "DB_Global".Inp.ThreePhaseOffConfirmed;
    ELSE
        // Values are deliberately cleared while DataValid is FALSE. HMI logic
        // must display COMMUNICATION FAULT / DATA INVALID, never a false normal.
        "DB_Global".PilzDiag.SafetyReady := FALSE;
        "DB_Global".PilzDiag.GeneralFault := FALSE;
        "DB_Global".PilzDiag.ResetRequired := FALSE;
        "DB_Global".PilzDiag.EStopChainHealthy := FALSE;
        "DB_Global".PilzDiag.AllGuardsClosed := FALSE;
        "DB_Global".PilzDiag.AllGuardsUnlocked := FALSE;
        "DB_Global".PilzDiag.SafetyCircuitClosed := FALSE;
        "DB_Global".PilzDiag.StandstillConfirmed := FALSE;
        "DB_Global".PilzDiag.ThreePhaseOffConfirmed := FALSE;
    END_IF;

    EffectiveCmd := "DB_Global".Cmd;
    EffectiveCmd.AutoStart := "DB_Global".Cmd.AutoStart OR "DB_Global".Inp.StartPanelPB;
    EffectiveCmd.ProductionOn := "DB_Global".Cmd.ProductionOn
                                 OR "DB_Global".Cmd.AutoStart
                                 OR "DB_Global".Inp.StartPanelPB;
    EffectiveCmd.Reset := "DB_Global".Cmd.Reset OR "DB_Global".Inp.ResetAlarmPanelPB;
    EffectiveCmd.Stop := "DB_Global".Cmd.Stop
                         OR "DB_Global".Inp.StopPanelPB
                         OR "DB_Global".DoorAccess.ControlledStopRequest
                         OR "DB_Global".OpenPoints.ControlledStopRequest;

    AutoBottleGate(
        RequestEnable := "DB_Global".Cmd.GateAutoRequestEnable,
        ProductionMode := "DB_Global".Machine.AutomaticActive,
        MachineRunning := "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CIPActive := "DB_Global".Machine.CIPActive,
        CriticalAlarm := "DB_Global".AlarmCritical,
        GateOpenFB := "DB_Global".Inp.GateOpenFB,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        AdmissionComplete := "DB_Global".Inp.BottleAdmissionComplete,
        ActualSpeedPct := "DB_Global".Inp.MainSpeedActualPct,
        ActualSpeedValid := "DB_Global".Inp.MainSpeedActualValid,
        MinSpeedPct := "DB_Global".Par.GateRequestMinSpeedPct,
        SpeedTolerancePct := "DB_Global".Par.GateRequestSpeedTolerancePct,
        StepTimeout := "DB_Global".Par.GateRequestStepTimeout,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".AutoGateRequest
    );

    RunOutProduct(
        RunOutMode := "DB_Global".Machine.RunOutActive,
        MachineRunning := "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductPresentAtPump := "DB_Global".Inp.ProductPresentAtPump,
        TankLevelPct := "DB_Global".Inp.TankLevelPct,
        BottleCount := "DB_Global".Inp.BottleCountInMachine,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        TankClosePct := "DB_Global".Par.RunOutTankClosePct,
        LastBottleDelay := "DB_Global".Par.RunOutLastBottleDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".RunOutProduct
    );

    EffectiveCmd.Stop := EffectiveCmd.Stop
                         OR "DB_Global".AutoGateRequest.StopRequest;

    CIPMediaPump(
        CIPActive := "DB_Global".Machine.CIPActive,
        ProductPresent := "DB_Global".Inp.ProductPresentAtPump,
        LossDelay := "DB_Global".Par.CIPMediaLossDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".CIP
    );

    // REV security: only a PLC-validated, approved and locked recipe may be
    // snapshotted for execution. The active snapshot is isolated from all
    // subsequent draft or approved-recipe edits.
    CIPRecipeManager(
        StartCmd := "DB_Global".Cmd.CIPStart,
        NextCmd := "DB_Global".Cmd.CIPNext,
        CIPActive := "DB_Global".Machine.CIPActive,
        CIPComplete := "DB_Global".CIPSequence.Complete,
        CIPFault := "DB_Global".CIPSequence.Fault,
        CIPAbortActive := "DB_Global".CIPSequence.AbortActive,
        CIPFaultCode := "DB_Global".CIPSequence.FaultCode,
        CIPPhase := "DB_Global".CIPSequence.Phase,
        CIPPhaseElapsed := "DB_Global".CIPSequence.PhaseElapsed,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        RunOutActive := "DB_Global".Machine.RunOutActive,
        InterfaceReady := (NOT "DB_Global".Par.CIPRequireRemoteHandshake)
                          OR ("DB_Global".CIPInterface.MasterConfigured
                              AND "DB_Global".CIPInterface.MasterCommOK
                              AND "DB_Global".Inp.CIPRemoteReady),
        Cmd := "DB_Global".Cmd,
        Draft := "DB_Global".CIPRecipeDraft,
        Approved := "DB_Global".CIPRecipe,
        Previous := "DB_Global".CIPRecipePrevious,
        Active := "DB_Global".CIPRecipeActive,
        Control := "DB_Global".CIPRecipeControl,
        Audit := "DB_Global".CIPRecipeAudit,
        Execution := "DB_Global".CIPExecutionHistory
    );

    EffectiveCmd.CIPStart := EffectiveCmd.CIPStart
                             AND "DB_Global".CIPRecipeControl.StartPermitted;
    "DB_Global".CIPStartBlocked := "DB_Global".Cmd.CIPStart
                                    AND NOT "DB_Global".CIPRecipeControl.StartPermitted;

    CIPSequence(
        CIPActive := "DB_Global".Machine.CIPActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        PauseCmd := "DB_Global".Cmd.CIPPause,
        ResumeCmd := "DB_Global".Cmd.CIPResume,
        AbortCmd := "DB_Global".Cmd.CIPAbort,
        NextCmd := "DB_Global".Cmd.CIPNext,
        AcknowledgeCompleteCmd := "DB_Global".Cmd.CIPAcknowledgeComplete,
        Reset := EffectiveCmd.Reset,
        Blink1Hz := "DB_Global".Inp.Blink1Hz,
        RemoteReady := "DB_Global".Inp.CIPRemoteReady,
        RemoteBusy := "DB_Global".Inp.CIPRemoteBusy,
        RemoteFault := "DB_Global".Inp.CIPRemoteFault,
        RequestAccepted := "DB_Global".Inp.CIPRemoteRequestAccepted,
        MediumAvailable := "DB_Global".Inp.CIPMediumAvailable,
        DischargeComplete := "DB_Global".Inp.CIPDischargeComplete,
        RequireRemoteHandshake := "DB_Global".Par.CIPRequireRemoteHandshake,
        RequireDischargeComplete := "DB_Global".Par.CIPRequireDischargeComplete,
        ColdWashTime := "DB_Global".Par.CIPColdWashTime,
        HotWashTime := "DB_Global".Par.CIPHotWashTime,
        AcidWashTime := "DB_Global".Par.CIPAcidWashTime,
        HotRinseTime := "DB_Global".Par.CIPHotRinseTime,
        ColdRinseTime := "DB_Global".Par.CIPColdRinseTime,
        CitraTime := "DB_Global".Par.CIPCitraTime,
        FinalRinseTime := "DB_Global".Par.CIPFinalRinseTime,
        DischargeTime := "DB_Global".Par.CIPDischargeTime,
        RemoteResponseTimeout := "DB_Global".Par.CIPRemoteResponseTimeout,
        S := "DB_Global".CIPSequence,
        I := "DB_Global".CIPInterface,
        R := "DB_Global".CIPRecipeActive
    );

    // Production product request is separate from every CIP medium request.
    "DB_Global".CIPInterface.ReqProduct :=
        "DB_Global".Machine.ProductionActive
        AND NOT "DB_Global".Machine.CIPActive
        AND "DB_Global".Inp.SafetyOK
        AND NOT "DB_Global".AlarmCritical;
    // REV18 AL104 is the fifth logical master and is reserved for Customer CIP.
    // No physical address or port mapping is implied by these symbolic signals.
    "DB_Global".CIPInterface.MasterConfigured := "DB_Global".Inp.IOLinkMaster5Configured;
    "DB_Global".CIPInterface.MasterCommOK := "DB_Global".Inp.IOLinkMaster5OK;

    "DB_Global".Out.CIPReqColdWater := "DB_Global".CIPInterface.ReqColdWater;
    "DB_Global".Out.CIPReqHotWater := "DB_Global".CIPInterface.ReqHotWater;
    "DB_Global".Out.CIPReqAcid := "DB_Global".CIPInterface.ReqAcid;
    "DB_Global".Out.CIPReqCitra := "DB_Global".CIPInterface.ReqCitra;
    "DB_Global".Out.CIPReqDischarge := "DB_Global".CIPInterface.ReqDischarge;
    "DB_Global".Out.ProductionReqProduct := "DB_Global".CIPInterface.ReqProduct;

    ProductionVacuum(
        ProductionActive := "DB_Global".Machine.ProductionActive,
        VacuumActualMbar := "DB_Global".Inp.VacuumActualMbar,
        VacuumSignalValid := "DB_Global".Inp.VacuumSignalValid,
        VacuumMinMbar := "DB_Global".Par.VacuumMinMbar,
        StartupDelay := "DB_Global".Par.VacuumStartupDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".ProductionVacuum
    );

    // Main filler-drive mechanical-jam protection. Standard telegram 1 does
    // not contain actual torque, therefore this commissioned layer detects a
    // sustained collapse of actual speed after the drive has first reached
    // its commanded speed. The latch is independent of the G120C F07900
    // three-second blocked-motor backup and is intentionally set to 500 ms.
    IF "DB_Global".Par.MainDriveMaxFrequencyHz > 0.0 THEN
        MainDriveJamCommandHz :=
            ("DB_Global".Out.MainSpeedPct / 100.0) *
            "DB_Global".Par.MainDriveMaxFrequencyHz;
    ELSE
        MainDriveJamCommandHz := 0.0;
    END_IF;

    MainDriveJamArmTimer(
        IN := "DB_Global".Out.MainRun
              AND "DB_Global".Inp.MainDriveFeedbackValid
              AND NOT "DB_Global".Inp.MainDriveFault
              AND (MainDriveJamCommandHz >= "DB_Global".Par.MainDriveJamMinCommandHz)
              AND (ABS("DB_Global".Inp.MainDriveActualHz) >=
                   (MainDriveJamCommandHz * "DB_Global".Par.MainDriveJamArmSpeedPct / 100.0)),
        PT := "DB_Global".Par.MainDriveJamArmDelay
    );

    IF NOT "DB_Global".Out.MainRun OR "DB_Global".Inp.MainDriveFault THEN
        MainDriveJamArmed := FALSE;
    ELSIF MainDriveJamArmTimer.Q THEN
        MainDriveJamArmed := TRUE;
    END_IF;

    MainDriveJamCondition :=
        MainDriveJamArmed
        AND "DB_Global".Out.MainRun
        AND "DB_Global".Inp.MainDriveFeedbackValid
        AND (MainDriveJamCommandHz >= "DB_Global".Par.MainDriveJamMinCommandHz)
        AND (ABS("DB_Global".Inp.MainDriveActualHz) <=
             (MainDriveJamCommandHz * "DB_Global".Par.MainDriveJamTripSpeedPct / 100.0));
    MainDriveJamTripTimer(
        IN := MainDriveJamCondition,
        PT := "DB_Global".Par.MainDriveJamTripDelay
    );

    IF MainDriveJamTripTimer.Q THEN
        "DB_Global".Machine.MainDriveMechanicalJam := TRUE;
    END_IF;
    IF EffectiveCmd.Reset
       AND NOT "DB_Global".Out.MainRun
       AND NOT MainDriveJamCondition THEN
        "DB_Global".Machine.MainDriveMechanicalJam := FALSE;
    END_IF;

    // Alarm evaluation is performed before state control.
    Alarms(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        GateFault := GateFault,
        PumpLevelFault := PumpLevelFault,
        SMCCommOK := "DB_Global".Inp.SMCCommOK,
        SMCConflict := SMCConflict,
        FillerMoveTimeout := FillerHeight.MovementTimeout,
        CapperMoveTimeout := CapperHeight.MovementTimeout,
        MainDriveFault := "DB_Global".Inp.MainDriveFault,
        ConveyorFault := "DB_Global".Inp.ConveyorFault,
        ProductPumpFault := "DB_Global".Inp.ProductPumpFault,
        CapDriveFault := "DB_Global".Inp.CapDriveFault,
        HoodFilterAlarm := "DB_Global".Inp.HoodFilterAlarm,
        EStopChain24VHealthy := "DB_Global".Inp.EStopChain24VHealthy,
        DoorAccessFault := "DB_Global".DoorAccess.Fault,
        AirFilterFault := "DB_Global".Auxiliaries.AirFilterFault,
        AirFilterChangeWarning := "DB_Global".Auxiliaries.AirFilterChangeWarning,
        SpeedParameterFault := SpeedParameterFault,
        PumpLowWarning := PumpLowWarning,
        CapperOutfeedCrash := "DB_Global".Inp.CapperOutfeedCrash,
        ProductLevelNotReached := "DB_Global".ProductLevelNotReached,
        AutoGateSequenceFault := "DB_Global".AutoGateRequest.Fault,
        CIPStartBlocked := "DB_Global".CIPStartBlocked,
        CIPMediaLossAlarm := "DB_Global".CIP.MediaLossAlarm,
        LowVacuumAlarm := "DB_Global".ProductionVacuum.LowVacuumAlarm,
        // REV21 treats an operator-requested CIP abort as controlled status,
        // not as the aggregate unexplained CIP trip.
        CIPSequenceFault := "DB_Global".CIPSequence.Fault
                            AND ("DB_Global".CIPSequence.FaultCode <> UINT#4),
        CapHopperLow := "DB_Global".Inp.CapHopperLow,
        CapChannelDemand := "DB_Global".Inp.CapChannelDemand,
        CapsMissing := "DB_Global".Inp.CapsMissing,
        CapperNotReady := "DB_Global".Machine.ProductionActive AND NOT "DB_Global".Inp.CapDriveReady,
        BottleShortage1Active := BottleShortage1Alarm,
        BottleShortage2Active := BottleShortage2Alarm,
        Accumulation1Active := Accumulation1Alarm,
        Accumulation2Active := Accumulation2Alarm,
        DriveNotReady := "DB_Global".Machine.ProductionActive
                         AND (NOT "DB_Global".Inp.MainDriveReady OR NOT "DB_Global".Inp.ConveyorReady),
        SafetySystemFault := "DB_Global".Inp.SafetySystemFault,
        CIPRemoteTimeout := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#5),
        CIPRemoteFault := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#3),
        CIPInvalidState := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#6),
        CIPOperatorAbort := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#4),
        CIPComplete := "DB_Global".CIPSequence.Complete,
        AL104CommFault := "DB_Global".Inp.IOLinkMaster5Configured AND NOT "DB_Global".Inp.IOLinkMaster5OK,
        CIPRecipeInvalid := "DB_Global".Machine.CIPActive AND NOT "DB_Global".CIPSequence.RecipeValid,
        CIPNextRejected := "DB_Global".CIPSequence.NextRejected,
        CapDistributorNoPulseFault := "DB_Global".OpenPoints.CapSystem.NoPulseFault,
        MainDriveMechanicalJam := "DB_Global".Machine.MainDriveMechanicalJam,
        MainDriveCommFault := NOT "DB_Global".Inp.MainDriveFeedbackValid,
        ConveyorDriveCommFault := NOT "DB_Global".Inp.ConveyorFeedbackValid,
        ProductPumpCommFault := NOT "DB_Global".Inp.ProductPumpFeedbackValid,
        CapDriveCommFault := NOT "DB_Global".Inp.CapDriveFeedbackValid,
        CriticalAlarm => "DB_Global".AlarmCritical,
        WarningAlarm => "DB_Global".AlarmWarning,
        AlarmWord1 => "DB_Global".AlarmWord1,
        AlarmWord2 => "DB_Global".AlarmWord2
    );

    StateManager(
        Cmd := EffectiveCmd,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        BenchCommissioningMode := "DB_Global".SimulationMode,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        DrivesReady := DrivesReady,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        CriticalAlarm := "DB_Global".AlarmCritical,
        StandbyRequest := StandbyRequest,
        DoorAccessActive := "DB_Global".DoorAccess.SequenceActive,
        DoorRestartPermitted := "DB_Global".DoorAccess.RestartPermitted,
        DoorAccessFault := "DB_Global".DoorAccess.Fault,
        FillerHeightActive := FillerActive,
        CapperHeightActive := CapperActive,
        StartupSafeStateOK := "DB_Global".StartupSafeState.StartPermitted,
        ProductionStartPermitted := NOT "DB_Global".ProductLevelNotReached,
        RunOutComplete := "DB_Global".RunOutProduct.Completed,
        M := "DB_Global".Machine
    );

    Auxiliaries(
        // Permanent commissioning behaviour: with SimulationMode selected,
        // the integrated auxiliary outputs can be proved before the cabinet
        // control-power monitor is physically installed. In machine mode the
        // real %I12.5 ControlPowerOK input remains mandatory.
        ControlPowerOK := "DB_Global".Inp.ControlPowerOK OR "DB_Global".SimulationMode,
        LightsOnPB := "DB_Global".Cmd.LightsOn,
        LightsOffPB := "DB_Global".Cmd.LightsOff,
        AirFilterOnPB := "DB_Global".Cmd.AirFilterOn,
        AirFilterOffPB := "DB_Global".Cmd.AirFilterOff,
        AirFilterPressureOK := "DB_Global".Inp.AirFilterPressureOK,
        AirFilterChangeRequired24V := "DB_Global".Inp.AirFilterChangeRequired24V,
        ResetAlarmPB := "DB_Global".Inp.ResetAlarmPanelPB OR "DB_Global".Cmd.Reset,
        AirFilterProofDelay := "DB_Global".Par.AirFilterProofDelay,
        A := "DB_Global".Auxiliaries
    );

    "DB_Global".Out.UnlockAllDoorsRequest := "DB_Global".DoorAccess.UnlockAllDoorsRequest;
    "DB_Global".Out.RequestBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestPanelBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestFrontBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestRearBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.MachineLightsRelayCmd := "DB_Global".Auxiliaries.MachineLightsRelayCmd;
    "DB_Global".Out.AirFilterRelayCmd := "DB_Global".Auxiliaries.AirFilterRelayCmd;

    LiftConfirmation(
        FillerSelected := "DB_Global".Machine.FillerHeightActive,
        CapperSelected := "DB_Global".Machine.CapperHeightActive,
        FillerConfirmPB := "DB_Global".Cmd.FillerLiftConfirm,
        CapperConfirmPB := "DB_Global".Cmd.CapperLiftConfirm,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        CriticalAlarm := "DB_Global".AlarmCritical,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".LiftConfirmation
    );

    FillerHeight(
        Enable := "DB_Global".Machine.FillerHeightActive,
        OtherHeightActive := CapperActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        ConfirmationOK := "DB_Global".LiftConfirmation.FillerConfirmed,
        UpSelector := "DB_Global".Cmd.PendantUp,
        DownSelector := "DB_Global".Cmd.PendantDown,
        LowLimit := "DB_Global".Inp.FillerLowLimit,
        HighLimit := "DB_Global".Inp.FillerHighLimit,
        MoveTimeout := "DB_Global".Par.LiftTimeout,
        Active => FillerActive,
        UpCmd => "DB_Global".Out.FillerUp,
        DownCmd => "DB_Global".Out.FillerDown
    );

    CapperHeight(
        Enable := "DB_Global".Machine.CapperHeightActive,
        OtherHeightActive := FillerActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        ConfirmationOK := "DB_Global".LiftConfirmation.CapperConfirmed,
        UpSelector := "DB_Global".Cmd.PendantUp,
        DownSelector := "DB_Global".Cmd.PendantDown,
        LowLimit := "DB_Global".Inp.CapperLowLimit,
        HighLimit := "DB_Global".Inp.CapperHighLimit,
        MoveTimeout := "DB_Global".Par.LiftTimeout,
        Active => CapperActive,
        UpCmd => "DB_Global".Out.CapperUp,
        DownCmd => "DB_Global".Out.CapperDown
    );

    IF "DB_Global".Par.MaxSpeedBPH > 0.0 THEN
        BenchMainSpeedPct :=
            LIMIT(MN := 0.0,
                  IN := ("DB_Global".Par.ProductionSpeedBPH /
                         "DB_Global".Par.MaxSpeedBPH) * 100.0,
                  MX := 100.0);
    ELSE
        BenchMainSpeedPct := 0.0;
    END_IF;

    JogTrackingValid := "DB_Global".Machine.TrackingValid OR "DB_Global".SimulationMode;
    JogPendant(
        ManualMode := "DB_Global".Machine.ManualActive,
        SafetyOK := "DB_Global".Inp.SafetyOK OR "DB_Global".SimulationMode,
        PendantConnected := "DB_Global".Inp.PendantConnected OR "DB_Global".SimulationMode,
        JogPB := "DB_Global".Cmd.JogPB,
        HeightModeActive := FillerActive OR CapperActive,
        MainDriveReady := "DB_Global".Inp.MainDriveReady,
        JogSpeedPct := SEL(
            G := "DB_Global".SimulationMode,
            IN0 := MIN(
                IN1 := "DB_Global".Par.JogSpeedPct,
                IN2 := SEL(G := "DB_Global".Par.MainDriveMaxFrequencyHz > 0.0,
                           IN0 := 0.0,
                           IN1 := ("DB_Global".Par.MainJogMaxFrequencyHz /
                                   "DB_Global".Par.MainDriveMaxFrequencyHz) * 100.0)),
            IN1 := BenchMainSpeedPct),
        RecoveryComplete := "DB_Global".RecoveryDone OR "DB_Global".SimulationMode,
        TrackingValid := JogTrackingValid,
        JogForwardCmd => "DB_Global".Out.MainRun,
        SpeedRefPct => JogSpeedPct
    );
    IF NOT "DB_Global".SimulationMode THEN
        "DB_Global".Machine.TrackingValid := JogTrackingValid;
    END_IF;

    AccumGate(
        EnableAuto := "DB_Global".Machine.ProductionActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        Shortage1 := "DB_Global".Inp.BottleShortage1,
        Shortage2 := "DB_Global".Inp.BottleShortage2,
        Accumulation1 := "DB_Global".Inp.Accumulation1,
        Accumulation2 := "DB_Global".Inp.Accumulation2,
        GateOpenFB := "DB_Global".Inp.GateOpenFB,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        ShortageDelay1 := "DB_Global".Par.ShortageDelay1,
        ShortageDelay2 := "DB_Global".Par.ShortageDelay2,
        AccumulationDelay1 := "DB_Global".Par.AccumulationDelay1,
        AccumulationDelay2 := "DB_Global".Par.AccumulationDelay2,
        GateTimeout := "DB_Global".Par.GateTimeout,
        ShortageSlowPct := "DB_Global".Par.ShortageSlowPct,
        AccumulationSlowPct := "DB_Global".Par.AccumulationSlowPct,
        GateOpenCmd => GateOpenCmd,
        GateCloseCmd => GateCloseCmd,
        SpeedLimitPct => SpeedLimitPct,
        StandbyRequest => StandbyRequest,
        GateFault => GateFault,
        Shortage1Active => BottleShortage1Alarm,
        Shortage2Active => BottleShortage2Alarm,
        Accumulation1Active => Accumulation1Alarm,
        Accumulation2Active => Accumulation2Alarm
    );

    ManualGate(
        ManualMode := "DB_Global".Machine.ManualActive,
        MenuActive := "DB_Global".Cmd.GateManualPageActive,
        SafetyOK := "DB_Global".Inp.SafetyOK OR "DB_Global".SimulationMode,
        ManualTestEnable := "DB_Global".Cmd.ManualTestEnable,
        OpenPB := "DB_Global".Cmd.GateManualOpen,
        ClosePB := "DB_Global".Cmd.GateManualClose,
        AutoOpenCmd := GateOpenCmd,
        AutoCloseCmd := GateCloseCmd,
        OpenCmd => GateFinalOpenCmd,
        CloseCmd => GateFinalCloseCmd,
        TestModeActive => ManualGateActive
    );

    // Command priority: CIP/safety/alarm closure, run-out, automatic gate
    // request, then the existing manual/accumulation command.
    IF ("DB_Global".Machine.CIPActive
        OR NOT "DB_Global".Inp.SafetyOK
        OR "DB_Global".AlarmCritical)
       AND NOT ("DB_Global".SimulationMode AND ManualSMCTestActive) THEN
        GateFinalOpenCmd := FALSE;
        GateFinalCloseCmd := TRUE;
    ELSIF "DB_Global".RunOutProduct.OverrideActive THEN
        GateFinalOpenCmd := "DB_Global".RunOutProduct.GateOpenCmd;
        GateFinalCloseCmd := "DB_Global".RunOutProduct.GateCloseCmd;
    ELSIF "DB_Global".AutoGateRequest.OverrideActive THEN
        GateFinalOpenCmd := "DB_Global".AutoGateRequest.GateOpenCmd;
        GateFinalCloseCmd := "DB_Global".AutoGateRequest.GateCloseCmd;
    END_IF;

    ProductPumpEnableCmd :=
        ("DB_Global".Machine.ProductionActive
         AND "DB_Global".Cmd.ProductPumpEnable
         AND "DB_Global".Inp.ProductPresentAtPump)
        OR ("DB_Global".Machine.RunOutActive
            AND "DB_Global".Cmd.ProductPumpEnable
            AND "DB_Global".RunOutProduct.PumpPermit)
        OR ("DB_Global".Machine.CIPActive
            AND "DB_Global".CIP.ProductPumpPermit)
        OR ("DB_Global".Machine.ManualActive
            AND "DB_Global".Cmd.ProductPumpManualEnable
            AND "DB_Global".Inp.ProductPresentAtPump);
    ProductPumpEmptying := "DB_Global".Machine.EmptyingActive
                           OR "DB_Global".RunOutProduct.IgnoreLowLevelStop;
    "DB_Global".Par.ProductPumpManualFrequencyHz :=
        LIMIT(MN := "DB_Global".Par.ProductPumpManualMinHz,
              IN := "DB_Global".Par.ProductPumpManualFrequencyHz,
              MX := "DB_Global".Par.ProductPumpManualMaxHz);

    ProductPump(
        Enable := ProductPumpEnableCmd,
        ManualMode := "DB_Global".Machine.ManualActive,
        EmptyingMode := ProductPumpEmptying,
        DriveReady := "DB_Global".Inp.ProductPumpReady,
        DriveFault := "DB_Global".Inp.ProductPumpFault,
        LevelPct := "DB_Global".Inp.TankLevelPct,
        SetpointPct := "DB_Global".Par.TankSetpointPct,
        DeadbandPct := "DB_Global".Par.TankDeadbandPct,
        MinSpeedPct := "DB_Global".Par.PumpMinSpeedPct,
        MaxSpeedPct := "DB_Global".Par.PumpMaxSpeedPct,
        RampPctPerCycle := "DB_Global".Par.PumpRampPctPerCycle,
        ManualFrequencyHz := "DB_Global".Par.ProductPumpManualFrequencyHz,
        ManualMinHz := "DB_Global".Par.ProductPumpManualMinHz,
        ManualMaxHz := "DB_Global".Par.ProductPumpManualMaxHz,
        DriveBaseFrequencyHz := "DB_Global".Par.DriveBaseFrequencyHz,
        RunCmd => "DB_Global".Out.ProductPumpRun,
        SpeedRefPct => "DB_Global".Out.ProductPumpSpeedPct,
        FrequencyRefHz => "DB_Global".Out.ProductPumpFrequencyHz,
        LevelSignalFault => PumpLevelFault,
        LowLevelWarning => PumpLowWarning
    );

    VacuumCIP(
        CIPMode := "DB_Global".Machine.CIPActive,
        TankFull100 := "DB_Global".Inp.TankFull100
                       OR ("DB_Global".Inp.TankLevelPct >= 99.5),
        ResetSequence := "DB_Global".Cmd.Reset,
        TankFullDelay := "DB_Global".Par.CIPTankFullDelay,
        PumpPreOpenDelay := "DB_Global".Par.CIPPumpPreOpenDelay,
        ValveOpenTime := "DB_Global".Par.CIPValve212OpenTime,
        PumpPostRunTime := "DB_Global".Par.CIPVacuumPostRunTime,
        S := "DB_Global".CIP,
        VacuumPumpCmd => CIPVacuumPumpCmd,
        Valve212Cmd => CIPValve212Cmd
    );

    "DB_Global".CIP.Medium := "DB_Global".CIPSequence.RequestedMedium;
    // TEMPORARY ISOLATED-BENCH OUTPUT TEST ONLY. The pump motor is not
    // connected. SimulationMode is the existing commissioning authority;
    // the exception additionally requires MANUAL and the manual page to be
    // active. Leaving the page, leaving MANUAL, pressing OFF or a PLC restart
    // removes the request. Remove this exception before machine/SAT use.
    VacuumPumpBenchPermit :=
        "DB_Global".SimulationMode
        AND "DB_Global".Machine.ManualActive
        AND "DB_Global".Cmd.GateManualPageActive;

    // In normal operation the standard safety and alarm permissives remain
    // mandatory. Clear the maintained request whenever neither the normal
    // permit nor the isolated-bench permit is valid.
    IF NOT (("DB_Global".Machine.ManualActive
             AND "DB_Global".Inp.SafetyOK
             AND NOT "DB_Global".AlarmCritical)
            OR VacuumPumpBenchPermit) THEN
        "DB_Global".Cmd.VacuumPumpManualEnable := FALSE;
    END_IF;
    "DB_Global".Out.VacuumPump := CIPVacuumPumpCmd
                                  OR "DB_Global".Machine.ProductionActive
                                  OR "DB_Global".Machine.RunOutActive
                                  OR ("DB_Global".Cmd.VacuumPumpManualEnable
                                      AND (("DB_Global".Machine.ManualActive
                                            AND "DB_Global".Inp.SafetyOK
                                            AND NOT "DB_Global".AlarmCritical)
                                           OR VacuumPumpBenchPermit));

    ProductCircuit(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        RunOutActive := "DB_Global".Machine.RunOutActive,
        CIPActive := "DB_Global".Machine.CIPActive,
        CIPValve217PathRequest := "DB_Global".Inp.CIPValve217PathRequest,
        CIPValve213PathRequest := "DB_Global".Inp.CIPValve213PathRequest,
        CIPValve212Cmd := CIPValve212Cmd,
        Valve210Cmd => "DB_Global".Out.Valve210Cmd,
        Valve217Cmd => "DB_Global".Out.Valve217Cmd,
        Valve213Cmd => "DB_Global".Out.Valve213Cmd,
        Valve212Cmd => "DB_Global".Out.Valve212Cmd,
        Valve247Cmd => "DB_Global".Out.Valve247Cmd
    );
    "DB_Global".Out.EV210 := "DB_Global".Out.Valve210Cmd;
    "DB_Global".Out.EV212 := "DB_Global".Out.Valve212Cmd;
    // Automatic cap-air requests. Manual SMC test requests are selected later
    // in one place and never mixed into the automatic command variables.
    "DB_Global".Out.EV220 := "DB_Global".Inp.CapChannelDemand;
    "DB_Global".Out.EV221 := "DB_Global".Inp.CapChannelDemand;
    // EV211 is retained for compatibility; physical mapping for valves 217,
    // 213 and 247 requires the confirmed electrical/I/O schedule.
    "DB_Global".Out.EV211 := "DB_Global".Machine.ProductionActive
                             OR "DB_Global".Machine.RunOutActive;

    // Conveyor coordination: selectable synchronised speed, conveyor-first
    // start and an HMI-adjustable normal-stop run-on. Safety/critical events
    // bypass the run-on inside FB_ConveyorSync.
    ProductionDriveDemand :=
        ("DB_Global".Machine.ProductionActive OR "DB_Global".Machine.RunOutActive)
        AND NOT "DB_Global".RunOutProduct.StopRequest;
    IF NOT SpeedParameterFault THEN
        AutomaticMainSpeedPct :=
            LIMIT(MN := 0.0,
                  IN := ("DB_Global".Par.ProductionSpeedBPH / "DB_Global".Par.MaxSpeedBPH) * 100.0,
                  MX := MIN(IN1 := SpeedLimitPct,
                            IN2 := "DB_Global".AutoGateRequest.SpeedLimitPct));
    ELSE
        AutomaticMainSpeedPct := 0.0;
    END_IF;

    ConveyorSync(
        ProductionRequest := ProductionDriveDemand,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ConveyorReady := "DB_Global".Inp.ConveyorReady,
        SyncEnable := "DB_Global".Cmd.ConveyorSyncEnable,
        MainSpeedRequestPct := AutomaticMainSpeedPct,
        BaseSpeedPct := "DB_Global".Par.ConveyorBaseSpeedPct,
        PositiveOffsetPct := "DB_Global".Par.ConveyorSpeedOffsetPct,
        PrestartTime := "DB_Global".Par.ConveyorPrestartTime,
        RunOnTime := "DB_Global".Par.ConveyorRunOnTime,
        ConveyorRunRequest => ConveyorRunRequest,
        ConveyorSpeedRequestPct => ConveyorSpeedRequestPct,
        MainStartPermit => ConveyorMainStartPermit,
        SyncActive => ConveyorSyncActive,
        RunOnActive => ConveyorRunOnActive
    );

    // Isolated bench/manual conveyor request. This exception never authorises
    // automatic or Production operation and remains bounded to 5..15 Hz.
    IF NOT ("DB_Global".SimulationMode AND
            "DB_Global".Machine.ManualActive) THEN
        "DB_Global".Cmd.ConveyorManualEnable := FALSE;
    END_IF;
    ConveyorBenchPermit :=
        "DB_Global".SimulationMode
        AND "DB_Global".Machine.ManualActive
        AND "DB_Global".Cmd.ConveyorManualEnable
        AND "DB_Global".Inp.ConveyorReady
        AND NOT "DB_Global".Inp.ConveyorFault;
    IF ConveyorBenchPermit THEN
        ConveyorRunRequest := TRUE;
        IF "DB_Global".Par.DriveBaseFrequencyHz > 0.0 THEN
            ConveyorSpeedRequestPct :=
                ("DB_Global".Par.ConveyorManualFrequencyHz /
                 "DB_Global".Par.DriveBaseFrequencyHz) * 100.0;
        ELSE
            ConveyorSpeedRequestPct := 0.0;
        END_IF;
        ConveyorMainStartPermit := FALSE;
        ConveyorSyncActive := FALSE;
        ConveyorRunOnActive := FALSE;
    END_IF;
    "DB_Global".Out.ConveyorSyncActive := ConveyorSyncActive;
    "DB_Global".Out.ConveyorRunOnActive := ConveyorRunOnActive;

    // Isolated bench/manual cap-distributor request. The operator supplies the
    // frequency from Unified; startup is zero and the PLC clamps it to the
    // configured drive base frequency. Automatic Production demand is not
    // enabled by this exception.
    IF NOT "DB_Global".Machine.ManualActive THEN
        "DB_Global".Cmd.CapDriveManualEnable := FALSE;
    END_IF;
    "DB_Global".Par.CapDriveManualFrequencyHz :=
        LIMIT(MN := 0.0,
              IN := "DB_Global".Par.CapDriveManualFrequencyHz,
              MX := "DB_Global".Par.DriveBaseFrequencyHz);
    CapDriveBenchPermit :=
        "DB_Global".Machine.ManualActive
        AND "DB_Global".Cmd.CapDriveManualEnable
        AND ("DB_Global".Par.CapDriveManualFrequencyHz > 0.0)
        AND ("DB_Global".Inp.SafetyOK OR "DB_Global".SimulationMode)
        AND "DB_Global".Inp.CapDriveReady
        AND "DB_Global".Inp.CapDriveFeedbackValid
        AND NOT "DB_Global".Inp.CapDriveFault;
    IF CapDriveBenchPermit AND
       ("DB_Global".Par.DriveBaseFrequencyHz > 0.0) THEN
        "DB_Global".Out.CapDriveSpeedPct :=
            ("DB_Global".Par.CapDriveManualFrequencyHz /
             "DB_Global".Par.DriveBaseFrequencyHz) * 100.0;
    END_IF;

    // Automatic main-drive command. JOG has priority only in Manual.
    IF ProductionDriveDemand AND ConveyorMainStartPermit THEN
        IF NOT SpeedParameterFault THEN
            "DB_Global".Out.MainRun := TRUE;
            "DB_Global".Out.MainSpeedPct := AutomaticMainSpeedPct;
        ELSE
            "DB_Global".Out.MainRun := FALSE;
            "DB_Global".Out.MainSpeedPct := 0.0;
        END_IF;
    ELSIF "DB_Global".Machine.ManualActive AND "DB_Global".Out.MainRun THEN
        "DB_Global".Out.MainSpeedPct := JogSpeedPct;
    ELSE
        "DB_Global".Out.MainRun := FALSE;
        "DB_Global".Out.MainSpeedPct := 0.0;
    END_IF;

    "DB_Global".Out.GateOpen := GateFinalOpenCmd;
    "DB_Global".Out.GateClose := GateFinalCloseCmd;

    ExternalBottleWash(
        ProductionMode := "DB_Global".Machine.ProductionActive,
        MachineRunning := "DB_Global".Out.MainRun,
        ManualMode := "DB_Global".Machine.ManualActive,
        JogActive := "DB_Global".Cmd.JogPB AND "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CIPActive := "DB_Global".Machine.CIPActive,
        BottleCount := "DB_Global".Inp.BottleCountInMachine,
        OffDelay := "DB_Global".Par.ExternalWashOffDelay,
        ValveCmd => "DB_Global".Out.ExternalBottleWashValveCmd
    );

    InternalWash(
        OnCmd := "DB_Global".Cmd.InternalWashOn,
        OffCmd := "DB_Global".Cmd.InternalWashOff,
        ProductionMode := "DB_Global".Machine.ProductionActive,
        ManualMode := "DB_Global".Machine.ManualActive,
        CIPActive := "DB_Global".Machine.CIPActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        SMCCommOK := "DB_Global".Inp.SMCCommOK,
        S := "DB_Global".InternalWash,
        ValveCmd => "DB_Global".Out.InternalWashValveCmd
    );

    ManualSMCTestActive :=
        "DB_Global".Machine.ManualActive
        // On the isolated bench, ManualTestEnable also recovers the page
        // session after a PLC restart while Unified remains on manual_valves.
        AND ("DB_Global".Cmd.GateManualPageActive OR "DB_Global".SimulationMode)
        AND "DB_Global".Cmd.ManualTestEnable
        AND ("DB_Global".Inp.SafetyOK OR "DB_Global".SimulationMode)
        AND "DB_Global".Inp.SMCCommOK
        AND (NOT "DB_Global".AlarmCritical OR "DB_Global".SimulationMode)
        AND NOT "DB_Global".Machine.DoorAccessActive;

    IF ManualSMCTestActive THEN
        SMCProductInletCmd := "DB_Global".Cmd.SMCEV010Manual;
        SMCProductCloseCmd := "DB_Global".Cmd.SMCEV011Manual;
        SMCEV210Cmd := "DB_Global".Cmd.SMCEV210Manual;
        SMCEV211Cmd := "DB_Global".Cmd.SMCEV211Manual;
        SMCEV212Cmd := "DB_Global".Cmd.SMCEV212Manual;
        SMCCapDistributorCmd := "DB_Global".Cmd.CapDistributorAirManual;
        SMCCapChannelCmd := "DB_Global".Cmd.CapChannelAirManual;
        SMCBottleWashCmd := "DB_Global".Cmd.SMCBottleExternalWashManual;
    ELSE
        SMCProductInletCmd := "DB_Global".Out.ProductPumpRun;
        SMCProductCloseCmd :=
            ("DB_Global".Machine.ProductionActive
             OR "DB_Global".Machine.RunOutActive
             OR "DB_Global".Machine.CIPActive)
            AND NOT "DB_Global".Out.ProductPumpRun;
        SMCEV210Cmd := "DB_Global".Out.EV210;
        SMCEV211Cmd := "DB_Global".Out.EV211;
        SMCEV212Cmd := "DB_Global".Out.EV212;
        SMCCapDistributorCmd := "DB_Global".Out.EV220;
        SMCCapChannelCmd := "DB_Global".Out.EV221;
        SMCBottleWashCmd := "DB_Global".Out.ExternalBottleWashValveCmd;
    END_IF;

    // REV03: 125Y10 is the spare VQC1200 station.  Retain the legacy DB
    // members for interface compatibility, but never turn them into an
    // Anybus output request or an HMI active indication.
    "DB_Global".Cmd.SMCFillerExternalWashManual := FALSE;
    "DB_Global".Out.FillerExternalWashValveCmd := FALSE;

    ValveManager(
        // The bench exception is valid only while every manual SMC test
        // condition is simultaneously true.  Automatic commands never use it.
        SafetyOK := "DB_Global".Inp.SafetyOK OR
                    ("DB_Global".SimulationMode AND ManualSMCTestActive),
        CommOK := "DB_Global".Inp.SMCCommOK,
        OutputsPermitted := NOT "DB_Global".Machine.AlarmStopActive
                            AND NOT "DB_Global".Machine.DoorAccessActive,
        GateOpenCmd := GateFinalOpenCmd,
        GateCloseCmd := GateFinalCloseCmd,
        ProductInletCmd := SMCProductInletCmd,
        ProductCloseCmd := SMCProductCloseCmd,
        EV210Cmd := SMCEV210Cmd,
        EV211Cmd := SMCEV211Cmd,
        EV212Cmd := SMCEV212Cmd,
        CapDistributorAir := SMCCapDistributorCmd,
        CapChannelAir := SMCCapChannelCmd,
        // Bottle external washing is the last assigned single-solenoid output.
        ExternalBottleWashPneuEnable := SMCBottleWashCmd,
        ValveBits => "DB_Global".Out.ValveBits,
        ConflictAlarm => SMCConflict
    );

    // TEMPORARY ISOLATED-BENCH VALVE TEST. With SimulationMode selected,
    // every manifold output is OFF unless the operator has enabled the manual
    // valve-test page and is actively holding its corresponding HMI command.
    // The two double-solenoid pairs remain mutually exclusive. Remove this
    // branch before machine/site commissioning with the real safety system.
    IF "DB_Global".SimulationMode THEN
        "DB_Global".Out.ValveBits := DWORD#0;
        IF ManualSMCTestActive THEN
            "DB_Global".Out.ValveBits.%X0 :=
                "DB_Global".Cmd.SMCEV010Manual AND NOT "DB_Global".Cmd.SMCEV011Manual;
            "DB_Global".Out.ValveBits.%X2 :=
                "DB_Global".Cmd.SMCEV011Manual AND NOT "DB_Global".Cmd.SMCEV010Manual;
            "DB_Global".Out.ValveBits.%X4 := "DB_Global".Cmd.SMCEV210Manual;
            "DB_Global".Out.ValveBits.%X6 := "DB_Global".Cmd.SMCEV211Manual;
            "DB_Global".Out.ValveBits.%X8 := "DB_Global".Cmd.SMCEV212Manual;
            "DB_Global".Out.ValveBits.%X10 := "DB_Global".Cmd.CapDistributorAirManual;
            "DB_Global".Out.ValveBits.%X12 := "DB_Global".Cmd.CapChannelAirManual;
            "DB_Global".Out.ValveBits.%X14 := "DB_Global".Cmd.SMCBottleExternalWashManual;
            "DB_Global".Out.ValveBits.%X16 :=
                "DB_Global".Cmd.GateManualOpen AND NOT "DB_Global".Cmd.GateManualClose;
            "DB_Global".Out.ValveBits.%X17 :=
                "DB_Global".Cmd.GateManualClose AND NOT "DB_Global".Cmd.GateManualOpen;
        END_IF;
    END_IF;

    "DB_Global".Out.SMCEV010Active := "DB_Global".Out.ValveBits.%X0;
    "DB_Global".Out.SMCEV011Active := "DB_Global".Out.ValveBits.%X2;
    "DB_Global".Out.SMCEV210Active := "DB_Global".Out.ValveBits.%X4;
    "DB_Global".Out.SMCEV211Active := "DB_Global".Out.ValveBits.%X6;
    "DB_Global".Out.SMCEV212Active := "DB_Global".Out.ValveBits.%X8;
    "DB_Global".Out.SMCEV220Active := "DB_Global".Out.ValveBits.%X10;
    "DB_Global".Out.SMCEV221Active := "DB_Global".Out.ValveBits.%X12;
    "DB_Global".Out.SMCBottleExternalWashActive := "DB_Global".Out.ValveBits.%X14;
    "DB_Global".Out.SMCEV001OpenActive := "DB_Global".Out.ValveBits.%X16;
    "DB_Global".Out.SMCEV001CloseActive := "DB_Global".Out.ValveBits.%X17;
    "DB_Global".Out.SMCFillerExternalWashActive := FALSE;

    // One-second machine efficiency counters. The state-machine and final
    // interlocked MainRun command remain the single authority for classification.
    EfficiencyPulse(CLK := "DB_Global".Inp.Blink1Hz);
    IF EfficiencyPulse.Q THEN
        "DB_Global".Efficiency.TotalSeconds := "DB_Global".Efficiency.TotalSeconds + 1;
        IF "DB_Global".AlarmCritical THEN
            "DB_Global".Efficiency.BreakdownSeconds := "DB_Global".Efficiency.BreakdownSeconds + 1;
        ELSIF "DB_Global".Out.MainRun THEN
            "DB_Global".Efficiency.RunSeconds := "DB_Global".Efficiency.RunSeconds + 1;
        ELSIF "DB_Global".Machine.StandbyActive THEN
            "DB_Global".Efficiency.WaitingSeconds := "DB_Global".Efficiency.WaitingSeconds + 1;
        ELSE
            "DB_Global".Efficiency.StopSeconds := "DB_Global".Efficiency.StopSeconds + 1;
        END_IF;
    END_IF;

    // Final cyclic open-point supervisor. It can only reduce permission or
    // force a safe output state; it never invents a physical address/mapping.
    OpenPointsSupervisor(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        MachineZero := "DB_Global".Inp.MachineZero,
        EncoderCount := "DB_Global".Inp.EncoderCount,
        MachineStopped := MachineStopped,
        HomeStart := EffectiveCmd.HomeStart,
        Reset := EffectiveCmd.Reset,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        BenchManualMainJogPermit :=
            "DB_Global".SimulationMode
            AND "DB_Global".Machine.ManualActive
            AND "DB_Global".Cmd.JogPB
            AND "DB_Global".Inp.MainDriveReady
            AND NOT "DB_Global".Inp.MainDriveFault
            AND NOT FillerActive
            AND NOT CapperActive,
        BenchManualProductPumpPermit :=
            "DB_Global".SimulationMode
            AND "DB_Global".Machine.ManualActive
            AND "DB_Global".Cmd.ProductPumpManualEnable
            AND "DB_Global".Inp.ProductPresentAtPump
            AND "DB_Global".Inp.ProductPumpReady
            AND NOT "DB_Global".Inp.ProductPumpFault
            AND NOT PumpLevelFault,
        BenchManualConveyorPermit := ConveyorBenchPermit,
        BenchManualCapDrivePermit := CapDriveBenchPermit,
        ConveyorRunRequest := ConveyorRunRequest,
        ConveyorSpeedRequestPct := ConveyorSpeedRequestPct,
        MachineState := "DB_Global".Machine.State,
        BottleInfeed := "DB_Global".Inp.BottleInfeed,
        MainReady := "DB_Global".Inp.MainDriveReady,
        MainFault := "DB_Global".Inp.MainDriveFault,
        MainRunning := "DB_Global".Inp.MainDriveRunning,
        MainActualHz := "DB_Global".Inp.MainDriveActualHz,
        MainFeedbackValid := "DB_Global".Inp.MainDriveFeedbackValid,
        ProductPumpReady := "DB_Global".Inp.ProductPumpReady,
        ProductPumpFault := "DB_Global".Inp.ProductPumpFault,
        ProductPumpRunning := "DB_Global".Inp.ProductPumpRunning,
        ProductPumpActualHz := "DB_Global".Inp.ProductPumpActualHz,
        ProductPumpFeedbackValid := "DB_Global".Inp.ProductPumpFeedbackValid,
        ConveyorReady := "DB_Global".Inp.ConveyorReady,
        ConveyorFault := "DB_Global".Inp.ConveyorFault,
        ConveyorRunning := "DB_Global".Inp.ConveyorRunning,
        ConveyorActualHz := "DB_Global".Inp.ConveyorActualHz,
        ConveyorFeedbackValid := "DB_Global".Inp.ConveyorFeedbackValid,
        CapDriveReady := "DB_Global".Inp.CapDriveReady,
        CapDriveFault := "DB_Global".Inp.CapDriveFault,
        CapDriveRunning := "DB_Global".Inp.CapDriveRunning,
        CapDriveActualHz := "DB_Global".Inp.CapDriveActualHz,
        CapDriveFeedbackValid := "DB_Global".Inp.CapDriveFeedbackValid,
        DriveBaseFrequencyHz := "DB_Global".Par.DriveBaseFrequencyHz,
        CapDistributorPulse := "DB_Global".Inp.CapDistributorPulse,
        CapDistributorPulseValid := "DB_Global".Inp.CapDistributorPulseValid,
        CapDistributorDelayToStart := "DB_Global".Par.CapDistributorDelayToStart,
        CapDistributorDelayToStop := "DB_Global".Par.CapDistributorDelayToStop,
        CapDistributorNoPulseTimeout := "DB_Global".Par.CapDistributorNoPulseTimeout,
        DriveNetworkOK := "DB_Global".Inp.DriveG120CNetworkOK,
        AnybusProfinetOK := "DB_Global".Inp.AnybusGatewayOK,
        AnybusEtherCATOK := "DB_Global".Inp.AnybusGatewayECATOK,
        SmcCommOK := "DB_Global".Inp.SMCCommOK,
        PilzCommOK := "DB_Global".Inp.PilzDeviceOK,
        AL100CommOK := "DB_Global".Inp.IOLinkMaster1OK,
        AL101CommOK := "DB_Global".Inp.IOLinkMaster2OK,
        AL102CommOK := "DB_Global".Inp.IOLinkMaster3OK,
        AL103CommOK := "DB_Global".Inp.IOLinkMaster4OK,
        AL104CommOK := "DB_Global".Inp.IOLinkMaster5OK,
        GateOpenFeedback := "DB_Global".Inp.GateOpenFB,
        GateClosedFeedback := "DB_Global".Inp.GateClosedFB,
        CapPresent := "DB_Global".Inp.CapPresent,
        CapHopperLow := "DB_Global".Inp.CapHopperLow,
        CapChannelDemand := "DB_Global".Inp.CapChannelDemand,
        CapsMissing := "DB_Global".Inp.CapsMissing,
        O := "DB_Global".OpenPoints,
        M := "DB_Global".Machine,
        Out := "DB_Global".Out
    );

    // Manual conveyor commissioning path. ConveyorBenchPermit proves bench
    // mode, Manual, drive Ready and no drive fault. Apply the bounded 5..15 Hz
    // request after the generic manager so commissioning state cannot suppress
    // Telegram 1 during the isolated-bench test.
    IF ConveyorBenchPermit AND
       ("DB_Global".Par.DriveBaseFrequencyHz > 0.0) THEN
        "DB_Global".Out.ConveyorRun := TRUE;
        "DB_Global".Out.ConveyorSpeedPct :=
            ("DB_Global".Par.ConveyorManualFrequencyHz /
             "DB_Global".Par.DriveBaseFrequencyHz) * 100.0;
    END_IF;

    // Manual cap-drive commissioning path. CapDriveBenchPermit already proves
    // Manual mode, positive setpoint, Safety OK, cyclic feedback, drive Ready
    // and no drive fault. Apply the permitted request after the generic drive
    // manager so unrelated commissioning state cannot suppress Telegram 1.
    IF CapDriveBenchPermit AND
       ("DB_Global".Par.DriveBaseFrequencyHz > 0.0) THEN
        "DB_Global".Out.CapDriveRun := TRUE;
        "DB_Global".Out.CapDriveSpeedPct :=
            ("DB_Global".Par.CapDriveManualFrequencyHz /
             "DB_Global".Par.DriveBaseFrequencyHz) * 100.0;
    END_IF;

    // Standard telegram 1 is configured in the hardware. These Hz values are
    // the approved logical command layer; raw PROFIdrive word mapping remains
    // a controlled commissioning step after each drive parameter set is read.
    IF "DB_Global".Par.DriveBaseFrequencyHz > 0.0 THEN
        IF "DB_Global".Par.MainDriveMaxFrequencyHz > 0.0 THEN
            "DB_Global".Out.MainFrequencyHz :=
                LIMIT(MN := 0.0,
                      IN := ("DB_Global".Out.MainSpeedPct / 100.0) *
                            "DB_Global".Par.MainDriveMaxFrequencyHz,
                      MX := "DB_Global".Par.MainDriveMaxFrequencyHz);
        ELSE
            "DB_Global".Out.MainFrequencyHz := 0.0;
        END_IF;
        "DB_Global".Out.ConveyorFrequencyHz :=
            ("DB_Global".Out.ConveyorSpeedPct / 100.0) * "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Out.ProductPumpFrequencyHz :=
            ("DB_Global".Out.ProductPumpSpeedPct / 100.0) * "DB_Global".Par.DriveBaseFrequencyHz;
        "DB_Global".Out.CapDriveFrequencyHz :=
            ("DB_Global".Out.CapDriveSpeedPct / 100.0) * "DB_Global".Par.DriveBaseFrequencyHz;
    ELSE
        "DB_Global".Out.MainFrequencyHz := 0.0;
        "DB_Global".Out.ConveyorFrequencyHz := 0.0;
        "DB_Global".Out.ProductPumpFrequencyHz := 0.0;
        "DB_Global".Out.CapDriveFrequencyHz := 0.0;
    END_IF;

    // G120C Standard telegram 1 output image. OFF1 is the default command;
    // ON is issued only by the final interlocked run commands. Bit 7 is a
    // momentary fault acknowledgement from the existing RESET request.
    MainDriveControlWord := WORD#16#047E;
    ConveyorControlWord := WORD#16#047E;
    ProductPumpControlWord := WORD#16#047E;
    CapDriveControlWord := WORD#16#047E;
    IF "DB_Global".Out.MainRun
       AND NOT "DB_Global".Machine.MainDriveMechanicalJam THEN
        MainDriveControlWord := WORD#16#047F;
    END_IF;
    IF "DB_Global".Out.ConveyorRun THEN
        ConveyorControlWord := WORD#16#047F;
    END_IF;
    IF "DB_Global".Out.ProductPumpRun THEN
        ProductPumpControlWord := WORD#16#047F;
    END_IF;
    IF "DB_Global".Out.CapDriveRun THEN
        CapDriveControlWord := WORD#16#047F;
    END_IF;
    IF EffectiveCmd.Reset THEN
        MainDriveControlWord.%X7 := TRUE;
        ConveyorControlWord.%X7 := TRUE;
        ProductPumpControlWord.%X7 := TRUE;
        CapDriveControlWord.%X7 := TRUE;
    END_IF;

    IF "DB_Global".Par.DriveBaseFrequencyHz > 0.0 THEN
        MainSpeedRaw := REAL_TO_INT(
            LIMIT(MN := -32768.0,
                  IN := ("DB_Global".Out.MainFrequencyHz /
                         "DB_Global".Par.DriveBaseFrequencyHz) * 16384.0,
                  MX := 32767.0));
        ConveyorSpeedRaw := REAL_TO_INT(
            LIMIT(MN := -32768.0,
                  IN := ("DB_Global".Out.ConveyorFrequencyHz /
                         "DB_Global".Par.DriveBaseFrequencyHz) * 16384.0,
                  MX := 32767.0));
        ProductPumpSpeedRaw := REAL_TO_INT(
            LIMIT(MN := -32768.0,
                  IN := ("DB_Global".Out.ProductPumpFrequencyHz /
                         "DB_Global".Par.DriveBaseFrequencyHz) * 16384.0,
                  MX := 32767.0));
        CapDriveSpeedRaw := REAL_TO_INT(
            LIMIT(MN := -32768.0,
                  IN := ("DB_Global".Out.CapDriveFrequencyHz /
                         "DB_Global".Par.DriveBaseFrequencyHz) * 16384.0,
                  MX := 32767.0));
    ELSE
        MainSpeedRaw := 0;
        ConveyorSpeedRaw := 0;
        ProductPumpSpeedRaw := 0;
        CapDriveSpeedRaw := 0;
    END_IF;

    %QW140 := MainDriveControlWord;
    %QW142 := INT_TO_WORD(MainSpeedRaw);
    %QW144 := ConveyorControlWord;
    %QW146 := INT_TO_WORD(ConveyorSpeedRaw);
    %QW148 := ProductPumpControlWord;
    %QW150 := INT_TO_WORD(ProductPumpSpeedRaw);
    %QW152 := CapDriveControlWord;
    %QW154 := INT_TO_WORD(CapDriveSpeedRaw);

    // M103 vacuum-pump contactor command. Physical output confirmed by the
    // operator on 2026-10-02; motor overload feedback remains unassigned.
    %Q4.0 := "DB_Global".Out.VacuumPump;
    %Q4.1 := "DB_Global".Out.MachineLightsRelayCmd;
    %Q4.2 := "DB_Global".Out.AirFilterRelayCmd;
    %Q4.3 := "DB_Global".Out.GateOpen;
    %Q4.4 := "DB_Global".Out.GateClose;
    %Q4.5 := "DB_Global".Out.FillerUp;
    %Q4.6 := "DB_Global".Out.FillerDown;
    %Q4.7 := "DB_Global".Out.CapperUp;
    %Q5.0 := "DB_Global".Out.CapperDown;
    %Q5.1 := "DB_Global".Out.EV210;
    %Q5.2 := "DB_Global".Out.EV211;
    %Q5.3 := "DB_Global".Out.EV212;
    %Q5.4 := "DB_Global".Out.EV220;
    %Q5.5 := "DB_Global".Out.EV221;
    %Q5.6 := "DB_Global".Out.EV230FastRelease;
    %Q5.7 := "DB_Global".Out.ExternalBottleWashValveCmd;
    %Q6.0 := "DB_Global".Out.UnlockAllDoorsRequest;
    %Q6.1 := "DB_Global".Out.RequestPanelBlueLampCmd;
    %Q6.2 := "DB_Global".Out.RequestFrontBlueLampCmd;
    %Q6.3 := "DB_Global".Out.RequestRearBlueLampCmd;
    %Q6.4 := "DB_Global".Out.Valve217Cmd;
    %Q6.5 := "DB_Global".Out.Valve213Cmd;
    %Q6.6 := "DB_Global".Out.Valve212Cmd;
    %Q6.7 := "DB_Global".Out.Valve247Cmd;
    %Q7.0 := "DB_Global".Out.InternalWashValveCmd;
    %Q7.1 := "DB_Global".Out.CIPReqColdWater;
    %Q7.2 := "DB_Global".Out.CIPReqHotWater;
    %Q7.3 := "DB_Global".Out.CIPReqAcid;
    %Q7.4 := "DB_Global".Out.CIPReqCitra;
    %Q7.5 := "DB_Global".Out.CIPReqDischarge;
    %Q7.6 := "DB_Global".Out.ProductionReqProduct;
    %Q7.7 := FALSE;

    // Single physical write for the verified 4-byte Anybus output image.
    // FB_SMC_ValveManager has already applied safety, communication, conflict
    // and command interlocks; reserved bits are always zero.
    // S7 DWORD storage is big-endian while the Anybus/EX260 process image
    // numbers output 0 from the least-significant bit of its first byte.
    // Reverse the four bytes without changing bit order inside each byte.
    "Y_SMC_EX260_OutputImage" := SWAP("DB_Global".Out.ValveBits);
END_FUNCTION_BLOCK
