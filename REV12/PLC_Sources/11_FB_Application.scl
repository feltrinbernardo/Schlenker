FUNCTION_BLOCK "FB_Application"
VAR
    StateManager        : "FB_MainState";
    ProductPump         : "FB_ProductPump";
    AccumGate           : "FB_AccumulationGate";
    FillerHeight        : "FB_HeightMode";
    CapperHeight        : "FB_HeightMode";
    JogPendant          : "FB_JogPendant";
    VacuumCIP           : "FB_VacuumCIP";
    ValveManager        : "FB_SMC_ValveManager";
    Alarms              : "FB_AlarmManager";
    DoorAccess          : "FB_DoorAccess";
    ManualGate          : "FB_ManualValveOverride";
    Auxiliaries         : "FB_Auxiliaries";
    NetworkDiagnostics  : "FB_NetworkDiagnostics";
    ExternalBottleWash : "FB_ExternalBottleWash";
    AutoBottleGate      : "FB_AutoBottleGateRequest";
    RunOutProduct       : "FB_RunOutProduct";
    CIPMediaPump        : "FB_CIPMediaPump";
    ProductionVacuum    : "FB_ProductionVacuum";
    ProductCircuit      : "FB_ProductCircuitManager";
    LiftConfirmation    : "FB_LiftConfirmation";
    CIPSequence         : "FB_CIPSequence";
    CIPRecipeManager    : "FB_CIPRecipeManager";
    InternalWash        : "FB_InternalWash";
    OpenPointsSupervisor: "FB_OpenPointsSupervisor";
    EfficiencyPulse     : R_TRIG;

    FillerActive        : Bool;
    CapperActive        : Bool;
    GateOpenCmd         : Bool;
    GateCloseCmd        : Bool;
    StandbyRequest      : Bool;
    SpeedLimitPct       : Real;
    GateFault           : Bool;
    PumpLevelFault      : Bool;
    PumpLowWarning      : Bool;
    SMCConflict         : Bool;
    DrivesReady         : Bool;
    MachineStopped      : Bool;
    JogSpeedPct         : Real;
    GateFinalOpenCmd    : Bool;
    GateFinalCloseCmd   : Bool;
    ManualGateActive    : Bool;
    SpeedParameterFault : Bool;
    EffectiveCmd        : "UDT_Command";
    ProductPumpEnableCmd: Bool;
    ProductPumpEmptying : Bool;
    CIPVacuumPumpCmd    : Bool;
    CIPValve212Cmd      : Bool;
    ProductionMediaReady : Bool;
    BottleShortage1Alarm : Bool;
    BottleShortage2Alarm : Bool;
    Accumulation1Alarm   : Bool;
    Accumulation2Alarm   : Bool;
END_VAR

BEGIN
    // Validate all HMI-adjustable process timings in the PLC. These are
    // process limits only; safety-certified timing remains outside this list.
    "DB_Global".Par.CIPTankFullDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPTankFullDelay, MX := T#10s);
    "DB_Global".Par.CIPPumpPreOpenDelay := LIMIT(MN := T#0s, IN := "DB_Global".Par.CIPPumpPreOpenDelay, MX := T#5s);
    "DB_Global".Par.CIPValve212OpenTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPValve212OpenTime, MX := T#20s);
    "DB_Global".Par.CIPVacuumPostRunTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPVacuumPostRunTime, MX := T#30s);
    "DB_Global".Par.CIPMediaLossDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPMediaLossDelay, MX := T#10s);
    "DB_Global".Par.VacuumStartupDelay := LIMIT(MN := T#1s, IN := "DB_Global".Par.VacuumStartupDelay, MX := T#15s);
    "DB_Global".Par.RunOutLastBottleDelay := LIMIT(MN := T#5s, IN := "DB_Global".Par.RunOutLastBottleDelay, MX := T#60s);
    "DB_Global".Par.ExternalWashOffDelay := LIMIT(MN := T#0s, IN := "DB_Global".Par.ExternalWashOffDelay, MX := T#10s);
    "DB_Global".Par.CIPColdWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPColdWashTime, MX := T#4h);
    "DB_Global".Par.CIPHotWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPHotWashTime, MX := T#4h);
    "DB_Global".Par.CIPAcidWashTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPAcidWashTime, MX := T#4h);
    "DB_Global".Par.CIPHotRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPHotRinseTime, MX := T#4h);
    "DB_Global".Par.CIPColdRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPColdRinseTime, MX := T#4h);
    "DB_Global".Par.CIPCitraTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPCitraTime, MX := T#4h);
    "DB_Global".Par.CIPFinalRinseTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPFinalRinseTime, MX := T#4h);
    "DB_Global".Par.CIPDischargeTime := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPDischargeTime, MX := T#1h);
    "DB_Global".Par.CIPRemoteResponseTimeout := LIMIT(MN := T#1s, IN := "DB_Global".Par.CIPRemoteResponseTimeout, MX := T#5m);

    // REV11 network diagnostics are retained and executed before state control.
    NetworkDiagnostics(
        Pilz_DeviceOK := "DB_Global".Inp.PilzDeviceOK,
        IOLinkMaster1_OK := "DB_Global".Inp.IOLinkMaster1OK,
        IOLinkMaster2_OK := "DB_Global".Inp.IOLinkMaster2OK,
        IOLinkMaster3_OK := "DB_Global".Inp.IOLinkMaster3OK,
        IOLinkMaster4_OK := "DB_Global".Inp.IOLinkMaster4OK,
        IOLinkMaster5_Configured := "DB_Global".Inp.IOLinkMaster5Configured,
        IOLinkMaster5_OK := "DB_Global".Inp.IOLinkMaster5OK,
        Drive_G120C_OK := "DB_Global".Inp.DriveG120CNetworkOK,
        HMI_LinkOK := "DB_Global".Inp.HMILinkOK,
        AnybusGateway_OK := "DB_Global".Inp.AnybusGatewayOK,
        AnybusGateway_ECAT_OK := "DB_Global".Inp.AnybusGatewayECATOK,
        NetworkOK => "DB_Global".NetworkOK,
        FaultyDeviceMask => "DB_Global".FaultyDeviceMask
    );

    // Device readiness summary.
    DrivesReady :=
        "DB_Global".Inp.MainDriveReady AND
        "DB_Global".Inp.ConveyorReady AND
        ("DB_Global".Inp.ProductPumpReady OR NOT "DB_Global".Cmd.ProductPumpEnable) AND
        "DB_Global".Inp.CapDriveReady AND
        "DB_Global".OpenPoints.ReadyPermissives;

    MachineStopped := NOT "DB_Global".Out.MainRun;
    SpeedParameterFault := ("DB_Global".Par.MaxSpeedBPH <= 0.0)
                           OR ("DB_Global".Par.ProductionSpeedBPH < 0.0);
    ProductionMediaReady := "DB_Global".Inp.ProductPresentAtPump
                            OR ("DB_Global".Inp.TankLevelPct >= "DB_Global".Par.ProductPumpStartMinLevelPct);
    "DB_Global".ProductLevelNotReached := NOT ProductionMediaReady;
    "DB_Global".CIPStartBlocked := "DB_Global".Cmd.CIPStart
                                   AND ("DB_Global".Machine.ProductionActive
                                        OR "DB_Global".Machine.RunOutActive);

    DoorAccess(
        RequestOpenDoorPanelPB := "DB_Global".Inp.RequestOpenDoorPanelPB,
        RequestOpenDoorFrontPB := "DB_Global".Inp.RequestOpenDoorFrontPB,
        RequestOpenDoorRearPB := "DB_Global".Inp.RequestOpenDoorRearPB,
        Blink1Hz := "DB_Global".Inp.Blink1Hz,
        MachineRunning := "DB_Global".Out.MainRun,
        ControlledStopComplete := "DB_Global".Inp.ControlledStopComplete,
        ZeroSpeedConfirmed := "DB_Global".Inp.ZeroSpeedConfirmed,
        ThreePhaseOffConfirmed := "DB_Global".Inp.ThreePhaseOffConfirmed,
        AllDoorsClosed := "DB_Global".Inp.AllDoorsClosed,
        AllDoorsUnlocked := "DB_Global".Inp.AllDoorsUnlocked,
        SafetyCircuitClosed := "DB_Global".Inp.SafetyCircuitClosed,
        SafetySystemFault := "DB_Global".Inp.SafetySystemFault,
        EStopChain24VHealthy := "DB_Global".Inp.EStopChain24VHealthy,
        AuxiliaryPanelPB := "DB_Global".Inp.AuxiliaryPanelPB,
        ResetAlarmPanelPB := "DB_Global".Inp.ResetAlarmPanelPB,
        ResetFault := "DB_Global".Cmd.Reset OR "DB_Global".Inp.ResetAlarmPanelPB,
        StopTimeout := "DB_Global".Par.DoorStopTimeout,
        PowerOffTimeout := "DB_Global".Par.DoorPowerOffTimeout,
        UnlockTimeout := "DB_Global".Par.DoorUnlockTimeout,
        D := "DB_Global".DoorAccess
    );

    // REV23: non-safety Pilz diagnostic view. These assignments do not alter
    // machine permissives or the validated Pilz safety authority. The current
    // TIA project contains no Pilz device/GSDML/process-image map, therefore
    // PhysicalMapConfigured remains FALSE and no absolute address is invented.
    "DB_Global".PilzDiag.CommunicationOK := "DB_Global".Inp.PilzDeviceOK;
    "DB_Global".PilzDiag.PhysicalMapConfigured := FALSE;
    "DB_Global".PilzDiag.DataValid := "DB_Global".PilzDiag.CommunicationOK
                                      AND "DB_Global".PilzDiag.PhysicalMapConfigured;
    IF "DB_Global".PilzDiag.DataValid THEN
        "DB_Global".PilzDiag.SafetyReady := "DB_Global".Inp.SafetyOK;
        "DB_Global".PilzDiag.GeneralFault := "DB_Global".Inp.SafetySystemFault;
        "DB_Global".PilzDiag.ResetRequired := "DB_Global".DoorAccess.AlarmResetRequired;
        "DB_Global".PilzDiag.EStopChainHealthy := "DB_Global".Inp.EStopChain24VHealthy;
        "DB_Global".PilzDiag.AllGuardsClosed := "DB_Global".Inp.AllDoorsClosed;
        "DB_Global".PilzDiag.AllGuardsUnlocked := "DB_Global".Inp.AllDoorsUnlocked;
        "DB_Global".PilzDiag.SafetyCircuitClosed := "DB_Global".Inp.SafetyCircuitClosed;
        "DB_Global".PilzDiag.StandstillConfirmed := "DB_Global".Inp.ZeroSpeedConfirmed;
        "DB_Global".PilzDiag.ThreePhaseOffConfirmed := "DB_Global".Inp.ThreePhaseOffConfirmed;
    ELSE
        // Values are deliberately cleared while DataValid is FALSE. HMI logic
        // must display COMMUNICATION FAULT / DATA INVALID, never a false normal.
        "DB_Global".PilzDiag.SafetyReady := FALSE;
        "DB_Global".PilzDiag.GeneralFault := FALSE;
        "DB_Global".PilzDiag.ResetRequired := FALSE;
        "DB_Global".PilzDiag.EStopChainHealthy := FALSE;
        "DB_Global".PilzDiag.AllGuardsClosed := FALSE;
        "DB_Global".PilzDiag.AllGuardsUnlocked := FALSE;
        "DB_Global".PilzDiag.SafetyCircuitClosed := FALSE;
        "DB_Global".PilzDiag.StandstillConfirmed := FALSE;
        "DB_Global".PilzDiag.ThreePhaseOffConfirmed := FALSE;
    END_IF;

    EffectiveCmd := "DB_Global".Cmd;
    EffectiveCmd.AutoStart := "DB_Global".Cmd.AutoStart OR "DB_Global".Inp.StartPanelPB;
    EffectiveCmd.ProductionOn := "DB_Global".Cmd.ProductionOn
                                 OR "DB_Global".Cmd.AutoStart
                                 OR "DB_Global".Inp.StartPanelPB;
    EffectiveCmd.Reset := "DB_Global".Cmd.Reset OR "DB_Global".Inp.ResetAlarmPanelPB;
    EffectiveCmd.Stop := "DB_Global".Cmd.Stop
                         OR "DB_Global".Inp.StopPanelPB
                         OR "DB_Global".DoorAccess.ControlledStopRequest
                         OR "DB_Global".OpenPoints.ControlledStopRequest;

    AutoBottleGate(
        RequestEnable := "DB_Global".Cmd.GateAutoRequestEnable,
        ProductionMode := "DB_Global".Machine.AutomaticActive,
        MachineRunning := "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CIPActive := "DB_Global".Machine.CIPActive,
        CriticalAlarm := "DB_Global".AlarmCritical,
        GateOpenFB := "DB_Global".Inp.GateOpenFB,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        AdmissionComplete := "DB_Global".Inp.BottleAdmissionComplete,
        ActualSpeedPct := "DB_Global".Inp.MainSpeedActualPct,
        ActualSpeedValid := "DB_Global".Inp.MainSpeedActualValid,
        MinSpeedPct := "DB_Global".Par.GateRequestMinSpeedPct,
        SpeedTolerancePct := "DB_Global".Par.GateRequestSpeedTolerancePct,
        StepTimeout := "DB_Global".Par.GateRequestStepTimeout,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".AutoGateRequest
    );

    RunOutProduct(
        RunOutMode := "DB_Global".Machine.RunOutActive,
        MachineRunning := "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductPresentAtPump := "DB_Global".Inp.ProductPresentAtPump,
        TankLevelPct := "DB_Global".Inp.TankLevelPct,
        BottleCount := "DB_Global".Inp.BottleCountInMachine,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        TankClosePct := "DB_Global".Par.RunOutTankClosePct,
        LastBottleDelay := "DB_Global".Par.RunOutLastBottleDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".RunOutProduct
    );

    EffectiveCmd.Stop := EffectiveCmd.Stop
                         OR "DB_Global".AutoGateRequest.StopRequest;

    CIPMediaPump(
        CIPActive := "DB_Global".Machine.CIPActive,
        ProductPresent := "DB_Global".Inp.ProductPresentAtPump,
        LossDelay := "DB_Global".Par.CIPMediaLossDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".CIP
    );

    // REV security: only a PLC-validated, approved and locked recipe may be
    // snapshotted for execution. The active snapshot is isolated from all
    // subsequent draft or approved-recipe edits.
    CIPRecipeManager(
        StartCmd := "DB_Global".Cmd.CIPStart,
        NextCmd := "DB_Global".Cmd.CIPNext,
        CIPActive := "DB_Global".Machine.CIPActive,
        CIPComplete := "DB_Global".CIPSequence.Complete,
        CIPFault := "DB_Global".CIPSequence.Fault,
        CIPAbortActive := "DB_Global".CIPSequence.AbortActive,
        CIPFaultCode := "DB_Global".CIPSequence.FaultCode,
        CIPPhase := "DB_Global".CIPSequence.Phase,
        CIPPhaseElapsed := "DB_Global".CIPSequence.PhaseElapsed,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        RunOutActive := "DB_Global".Machine.RunOutActive,
        InterfaceReady := (NOT "DB_Global".Par.CIPRequireRemoteHandshake)
                          OR ("DB_Global".CIPInterface.MasterConfigured
                              AND "DB_Global".CIPInterface.MasterCommOK
                              AND "DB_Global".Inp.CIPRemoteReady),
        Cmd := "DB_Global".Cmd,
        Draft := "DB_Global".CIPRecipeDraft,
        Approved := "DB_Global".CIPRecipe,
        Previous := "DB_Global".CIPRecipePrevious,
        Active := "DB_Global".CIPRecipeActive,
        Control := "DB_Global".CIPRecipeControl,
        Audit := "DB_Global".CIPRecipeAudit,
        Execution := "DB_Global".CIPExecutionHistory
    );

    EffectiveCmd.CIPStart := EffectiveCmd.CIPStart
                             AND "DB_Global".CIPRecipeControl.StartPermitted;
    "DB_Global".CIPStartBlocked := "DB_Global".Cmd.CIPStart
                                    AND NOT "DB_Global".CIPRecipeControl.StartPermitted;

    CIPSequence(
        CIPActive := "DB_Global".Machine.CIPActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        PauseCmd := "DB_Global".Cmd.CIPPause,
        ResumeCmd := "DB_Global".Cmd.CIPResume,
        AbortCmd := "DB_Global".Cmd.CIPAbort,
        NextCmd := "DB_Global".Cmd.CIPNext,
        AcknowledgeCompleteCmd := "DB_Global".Cmd.CIPAcknowledgeComplete,
        Reset := EffectiveCmd.Reset,
        Blink1Hz := "DB_Global".Inp.Blink1Hz,
        RemoteReady := "DB_Global".Inp.CIPRemoteReady,
        RemoteBusy := "DB_Global".Inp.CIPRemoteBusy,
        RemoteFault := "DB_Global".Inp.CIPRemoteFault,
        RequestAccepted := "DB_Global".Inp.CIPRemoteRequestAccepted,
        MediumAvailable := "DB_Global".Inp.CIPMediumAvailable,
        DischargeComplete := "DB_Global".Inp.CIPDischargeComplete,
        RequireRemoteHandshake := "DB_Global".Par.CIPRequireRemoteHandshake,
        RequireDischargeComplete := "DB_Global".Par.CIPRequireDischargeComplete,
        ColdWashTime := "DB_Global".Par.CIPColdWashTime,
        HotWashTime := "DB_Global".Par.CIPHotWashTime,
        AcidWashTime := "DB_Global".Par.CIPAcidWashTime,
        HotRinseTime := "DB_Global".Par.CIPHotRinseTime,
        ColdRinseTime := "DB_Global".Par.CIPColdRinseTime,
        CitraTime := "DB_Global".Par.CIPCitraTime,
        FinalRinseTime := "DB_Global".Par.CIPFinalRinseTime,
        DischargeTime := "DB_Global".Par.CIPDischargeTime,
        RemoteResponseTimeout := "DB_Global".Par.CIPRemoteResponseTimeout,
        S := "DB_Global".CIPSequence,
        I := "DB_Global".CIPInterface,
        R := "DB_Global".CIPRecipeActive
    );

    // Production product request is separate from every CIP medium request.
    "DB_Global".CIPInterface.ReqProduct :=
        "DB_Global".Machine.ProductionActive
        AND NOT "DB_Global".Machine.CIPActive
        AND "DB_Global".Inp.SafetyOK
        AND NOT "DB_Global".AlarmCritical;
    // REV18 AL104 is the fifth logical master and is reserved for Customer CIP.
    // No physical address or port mapping is implied by these symbolic signals.
    "DB_Global".CIPInterface.MasterConfigured := "DB_Global".Inp.IOLinkMaster5Configured;
    "DB_Global".CIPInterface.MasterCommOK := "DB_Global".Inp.IOLinkMaster5OK;

    "DB_Global".Out.CIPReqColdWater := "DB_Global".CIPInterface.ReqColdWater;
    "DB_Global".Out.CIPReqHotWater := "DB_Global".CIPInterface.ReqHotWater;
    "DB_Global".Out.CIPReqAcid := "DB_Global".CIPInterface.ReqAcid;
    "DB_Global".Out.CIPReqCitra := "DB_Global".CIPInterface.ReqCitra;
    "DB_Global".Out.CIPReqDischarge := "DB_Global".CIPInterface.ReqDischarge;
    "DB_Global".Out.ProductionReqProduct := "DB_Global".CIPInterface.ReqProduct;

    ProductionVacuum(
        ProductionActive := "DB_Global".Machine.ProductionActive,
        VacuumActualMbar := "DB_Global".Inp.VacuumActualMbar,
        VacuumSignalValid := "DB_Global".Inp.VacuumSignalValid,
        VacuumMinMbar := "DB_Global".Par.VacuumMinMbar,
        StartupDelay := "DB_Global".Par.VacuumStartupDelay,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".ProductionVacuum
    );

    // Alarm evaluation is performed before state control.
    Alarms(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        GateFault := GateFault,
        PumpLevelFault := PumpLevelFault,
        SMCCommOK := "DB_Global".Inp.SMCCommOK,
        SMCConflict := SMCConflict,
        FillerMoveTimeout := FillerHeight.MovementTimeout,
        CapperMoveTimeout := CapperHeight.MovementTimeout,
        MainDriveFault := "DB_Global".Inp.MainDriveFault,
        ConveyorFault := "DB_Global".Inp.ConveyorFault,
        ProductPumpFault := "DB_Global".Inp.ProductPumpFault,
        CapDriveFault := "DB_Global".Inp.CapDriveFault,
        HoodFilterAlarm := "DB_Global".Inp.HoodFilterAlarm,
        EStopChain24VHealthy := "DB_Global".Inp.EStopChain24VHealthy,
        DoorAccessFault := "DB_Global".DoorAccess.Fault,
        AirFilterFault := "DB_Global".Auxiliaries.AirFilterFault,
        AirFilterChangeWarning := "DB_Global".Auxiliaries.AirFilterChangeWarning,
        SpeedParameterFault := SpeedParameterFault,
        PumpLowWarning := PumpLowWarning,
        CapperOutfeedCrash := "DB_Global".Inp.CapperOutfeedCrash,
        ProductLevelNotReached := "DB_Global".ProductLevelNotReached,
        AutoGateSequenceFault := "DB_Global".AutoGateRequest.Fault,
        CIPStartBlocked := "DB_Global".CIPStartBlocked,
        CIPMediaLossAlarm := "DB_Global".CIP.MediaLossAlarm,
        LowVacuumAlarm := "DB_Global".ProductionVacuum.LowVacuumAlarm,
        // REV21 treats an operator-requested CIP abort as controlled status,
        // not as the aggregate unexplained CIP trip.
        CIPSequenceFault := "DB_Global".CIPSequence.Fault
                            AND ("DB_Global".CIPSequence.FaultCode <> UINT#4),
        CapHopperLow := "DB_Global".Inp.CapHopperLow,
        CapChannelDemand := "DB_Global".Inp.CapChannelDemand,
        CapsMissing := "DB_Global".Inp.CapsMissing,
        CapperNotReady := "DB_Global".Machine.ProductionActive AND NOT "DB_Global".Inp.CapDriveReady,
        BottleShortage1Active := BottleShortage1Alarm,
        BottleShortage2Active := BottleShortage2Alarm,
        Accumulation1Active := Accumulation1Alarm,
        Accumulation2Active := Accumulation2Alarm,
        DriveNotReady := "DB_Global".Machine.ProductionActive
                         AND (NOT "DB_Global".Inp.MainDriveReady OR NOT "DB_Global".Inp.ConveyorReady),
        SafetySystemFault := "DB_Global".Inp.SafetySystemFault,
        CIPRemoteTimeout := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#5),
        CIPRemoteFault := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#3),
        CIPInvalidState := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#6),
        CIPOperatorAbort := "DB_Global".CIPSequence.Fault AND ("DB_Global".CIPSequence.FaultCode = UINT#4),
        CIPComplete := "DB_Global".CIPSequence.Complete,
        AL104CommFault := "DB_Global".Inp.IOLinkMaster5Configured AND NOT "DB_Global".Inp.IOLinkMaster5OK,
        CIPRecipeInvalid := "DB_Global".Machine.CIPActive AND NOT "DB_Global".CIPSequence.RecipeValid,
        CIPNextRejected := "DB_Global".CIPSequence.NextRejected,
        CriticalAlarm => "DB_Global".AlarmCritical,
        WarningAlarm => "DB_Global".AlarmWarning,
        AlarmWord1 => "DB_Global".AlarmWord1,
        AlarmWord2 => "DB_Global".AlarmWord2
    );

    StateManager(
        Cmd := EffectiveCmd,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        DrivesReady := DrivesReady,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        CriticalAlarm := "DB_Global".AlarmCritical,
        StandbyRequest := StandbyRequest,
        DoorAccessActive := "DB_Global".DoorAccess.SequenceActive,
        DoorRestartPermitted := "DB_Global".DoorAccess.RestartPermitted,
        DoorAccessFault := "DB_Global".DoorAccess.Fault,
        FillerHeightActive := FillerActive,
        CapperHeightActive := CapperActive,
        ProductionStartPermitted := NOT "DB_Global".ProductLevelNotReached,
        RunOutComplete := "DB_Global".RunOutProduct.Completed,
        M := "DB_Global".Machine
    );

    Auxiliaries(
        ControlPowerOK := "DB_Global".Inp.ControlPowerOK,
        LightsOnPB := "DB_Global".Cmd.LightsOn,
        LightsOffPB := "DB_Global".Cmd.LightsOff,
        AirFilterOnPB := "DB_Global".Cmd.AirFilterOn,
        AirFilterOffPB := "DB_Global".Cmd.AirFilterOff,
        AirFilterPressureOK := "DB_Global".Inp.AirFilterPressureOK,
        AirFilterChangeRequired24V := "DB_Global".Inp.AirFilterChangeRequired24V,
        ResetAlarmPB := "DB_Global".Inp.ResetAlarmPanelPB OR "DB_Global".Cmd.Reset,
        AirFilterProofDelay := "DB_Global".Par.AirFilterProofDelay,
        A := "DB_Global".Auxiliaries
    );

    "DB_Global".Out.UnlockAllDoorsRequest := "DB_Global".DoorAccess.UnlockAllDoorsRequest;
    "DB_Global".Out.RequestBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestPanelBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestFrontBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.RequestRearBlueLampCmd := "DB_Global".DoorAccess.RequestBlueLampCmd;
    "DB_Global".Out.MachineLightsRelayCmd := "DB_Global".Auxiliaries.MachineLightsRelayCmd;
    "DB_Global".Out.AirFilterRelayCmd := "DB_Global".Auxiliaries.AirFilterRelayCmd;

    LiftConfirmation(
        FillerSelected := "DB_Global".Machine.FillerHeightActive,
        CapperSelected := "DB_Global".Machine.CapperHeightActive,
        FillerConfirmPB := "DB_Global".Cmd.FillerLiftConfirm,
        CapperConfirmPB := "DB_Global".Cmd.CapperLiftConfirm,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        CriticalAlarm := "DB_Global".AlarmCritical,
        Reset := EffectiveCmd.Reset,
        S := "DB_Global".LiftConfirmation
    );

    FillerHeight(
        Enable := "DB_Global".Machine.FillerHeightActive,
        OtherHeightActive := CapperActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        ConfirmationOK := "DB_Global".LiftConfirmation.FillerConfirmed,
        UpSelector := "DB_Global".Cmd.PendantUp,
        DownSelector := "DB_Global".Cmd.PendantDown,
        LowLimit := "DB_Global".Inp.FillerLowLimit,
        HighLimit := "DB_Global".Inp.FillerHighLimit,
        MoveTimeout := "DB_Global".Par.LiftTimeout,
        Active => FillerActive,
        UpCmd => "DB_Global".Out.FillerUp,
        DownCmd => "DB_Global".Out.FillerDown
    );

    CapperHeight(
        Enable := "DB_Global".Machine.CapperHeightActive,
        OtherHeightActive := FillerActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        MachineStopped := MachineStopped,
        ConfirmationOK := "DB_Global".LiftConfirmation.CapperConfirmed,
        UpSelector := "DB_Global".Cmd.PendantUp,
        DownSelector := "DB_Global".Cmd.PendantDown,
        LowLimit := "DB_Global".Inp.CapperLowLimit,
        HighLimit := "DB_Global".Inp.CapperHighLimit,
        MoveTimeout := "DB_Global".Par.LiftTimeout,
        Active => CapperActive,
        UpCmd => "DB_Global".Out.CapperUp,
        DownCmd => "DB_Global".Out.CapperDown
    );

    JogPendant(
        ManualMode := "DB_Global".Machine.ManualActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        PendantConnected := "DB_Global".Inp.PendantConnected,
        JogPB := "DB_Global".Cmd.JogPB,
        HeightModeActive := FillerActive OR CapperActive,
        MainDriveReady := "DB_Global".Inp.MainDriveReady,
        JogSpeedPct := "DB_Global".Par.JogSpeedPct,
        RecoveryComplete := "DB_Global".RecoveryDone,
        TrackingValid := "DB_Global".Machine.TrackingValid,
        JogForwardCmd => "DB_Global".Out.MainRun,
        SpeedRefPct => JogSpeedPct
    );

    AccumGate(
        EnableAuto := "DB_Global".Machine.ProductionActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        Shortage1 := "DB_Global".Inp.BottleShortage1,
        Shortage2 := "DB_Global".Inp.BottleShortage2,
        Accumulation1 := "DB_Global".Inp.Accumulation1,
        Accumulation2 := "DB_Global".Inp.Accumulation2,
        GateOpenFB := "DB_Global".Inp.GateOpenFB,
        GateClosedFB := "DB_Global".Inp.GateClosedFB,
        ShortageDelay1 := "DB_Global".Par.ShortageDelay1,
        ShortageDelay2 := "DB_Global".Par.ShortageDelay2,
        AccumulationDelay1 := "DB_Global".Par.AccumulationDelay1,
        AccumulationDelay2 := "DB_Global".Par.AccumulationDelay2,
        GateTimeout := "DB_Global".Par.GateTimeout,
        ShortageSlowPct := "DB_Global".Par.ShortageSlowPct,
        AccumulationSlowPct := "DB_Global".Par.AccumulationSlowPct,
        GateOpenCmd => GateOpenCmd,
        GateCloseCmd => GateCloseCmd,
        SpeedLimitPct => SpeedLimitPct,
        StandbyRequest => StandbyRequest,
        GateFault => GateFault,
        Shortage1Active => BottleShortage1Alarm,
        Shortage2Active => BottleShortage2Alarm,
        Accumulation1Active => Accumulation1Alarm,
        Accumulation2Active => Accumulation2Alarm
    );

    ManualGate(
        ManualMode := "DB_Global".Machine.ManualActive,
        MenuActive := "DB_Global".Cmd.GateManualPageActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        ManualTestEnable := "DB_Global".Cmd.ManualTestEnable,
        OpenPB := "DB_Global".Cmd.GateManualOpen,
        ClosePB := "DB_Global".Cmd.GateManualClose,
        AutoOpenCmd := GateOpenCmd,
        AutoCloseCmd := GateCloseCmd,
        OpenCmd => GateFinalOpenCmd,
        CloseCmd => GateFinalCloseCmd,
        TestModeActive => ManualGateActive
    );

    // Command priority: CIP/safety/alarm closure, run-out, automatic gate
    // request, then the existing manual/accumulation command.
    IF "DB_Global".Machine.CIPActive
       OR NOT "DB_Global".Inp.SafetyOK
       OR "DB_Global".AlarmCritical THEN
        GateFinalOpenCmd := FALSE;
        GateFinalCloseCmd := TRUE;
    ELSIF "DB_Global".RunOutProduct.OverrideActive THEN
        GateFinalOpenCmd := "DB_Global".RunOutProduct.GateOpenCmd;
        GateFinalCloseCmd := "DB_Global".RunOutProduct.GateCloseCmd;
    ELSIF "DB_Global".AutoGateRequest.OverrideActive THEN
        GateFinalOpenCmd := "DB_Global".AutoGateRequest.GateOpenCmd;
        GateFinalCloseCmd := "DB_Global".AutoGateRequest.GateCloseCmd;
    END_IF;

    ProductPumpEnableCmd :=
        ("DB_Global".Machine.ProductionActive
         AND "DB_Global".Cmd.ProductPumpEnable
         AND "DB_Global".Inp.ProductPresentAtPump)
        OR ("DB_Global".Machine.RunOutActive
            AND "DB_Global".Cmd.ProductPumpEnable
            AND "DB_Global".RunOutProduct.PumpPermit)
        OR ("DB_Global".Machine.CIPActive
            AND "DB_Global".CIP.ProductPumpPermit)
        OR ("DB_Global".Machine.ManualActive
            AND "DB_Global".Cmd.ProductPumpManualEnable
            AND "DB_Global".Inp.ProductPresentAtPump);
    ProductPumpEmptying := "DB_Global".Machine.EmptyingActive
                           OR "DB_Global".RunOutProduct.IgnoreLowLevelStop;

    ProductPump(
        Enable := ProductPumpEnableCmd,
        EmptyingMode := ProductPumpEmptying,
        DriveReady := "DB_Global".Inp.ProductPumpReady,
        DriveFault := "DB_Global".Inp.ProductPumpFault,
        LevelPct := "DB_Global".Inp.TankLevelPct,
        SetpointPct := "DB_Global".Par.TankSetpointPct,
        DeadbandPct := "DB_Global".Par.TankDeadbandPct,
        MinSpeedPct := "DB_Global".Par.PumpMinSpeedPct,
        MaxSpeedPct := "DB_Global".Par.PumpMaxSpeedPct,
        RampPctPerCycle := "DB_Global".Par.PumpRampPctPerCycle,
        RunCmd => "DB_Global".Out.ProductPumpRun,
        SpeedRefPct => "DB_Global".Out.ProductPumpSpeedPct,
        LevelSignalFault => PumpLevelFault,
        LowLevelWarning => PumpLowWarning
    );

    VacuumCIP(
        CIPMode := "DB_Global".Machine.CIPActive,
        TankFull100 := "DB_Global".Inp.TankFull100
                       OR ("DB_Global".Inp.TankLevelPct >= 99.5),
        ResetSequence := "DB_Global".Cmd.Reset,
        TankFullDelay := "DB_Global".Par.CIPTankFullDelay,
        PumpPreOpenDelay := "DB_Global".Par.CIPPumpPreOpenDelay,
        ValveOpenTime := "DB_Global".Par.CIPValve212OpenTime,
        PumpPostRunTime := "DB_Global".Par.CIPVacuumPostRunTime,
        S := "DB_Global".CIP,
        VacuumPumpCmd => CIPVacuumPumpCmd,
        Valve212Cmd => CIPValve212Cmd
    );

    "DB_Global".CIP.Medium := "DB_Global".CIPSequence.RequestedMedium;
    "DB_Global".Out.VacuumPump := CIPVacuumPumpCmd
                                  OR "DB_Global".Machine.ProductionActive
                                  OR "DB_Global".Machine.RunOutActive;

    ProductCircuit(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        RunOutActive := "DB_Global".Machine.RunOutActive,
        CIPActive := "DB_Global".Machine.CIPActive,
        CIPValve217PathRequest := "DB_Global".Inp.CIPValve217PathRequest,
        CIPValve213PathRequest := "DB_Global".Inp.CIPValve213PathRequest,
        CIPValve212Cmd := CIPValve212Cmd,
        Valve210Cmd => "DB_Global".Out.Valve210Cmd,
        Valve217Cmd => "DB_Global".Out.Valve217Cmd,
        Valve213Cmd => "DB_Global".Out.Valve213Cmd,
        Valve212Cmd => "DB_Global".Out.Valve212Cmd,
        Valve247Cmd => "DB_Global".Out.Valve247Cmd
    );
    "DB_Global".Out.EV210 := "DB_Global".Out.Valve210Cmd;
    "DB_Global".Out.EV212 := "DB_Global".Out.Valve212Cmd;
    // EV211 is retained for compatibility; physical mapping for valves 217,
    // 213 and 247 requires the confirmed electrical/I/O schedule.
    "DB_Global".Out.EV211 := "DB_Global".Machine.ProductionActive
                             OR "DB_Global".Machine.RunOutActive;

    // Automatic main-drive command. JOG has priority only in Manual.
    IF ("DB_Global".Machine.ProductionActive OR "DB_Global".Machine.RunOutActive)
       AND NOT "DB_Global".RunOutProduct.StopRequest THEN
        IF NOT SpeedParameterFault THEN
            "DB_Global".Out.MainRun := TRUE;
            "DB_Global".Out.MainSpeedPct :=
                LIMIT(MN := 0.0,
                      IN := ("DB_Global".Par.ProductionSpeedBPH / "DB_Global".Par.MaxSpeedBPH) * 100.0,
                      MX := MIN(IN1 := SpeedLimitPct,
                                IN2 := "DB_Global".AutoGateRequest.SpeedLimitPct));
        ELSE
            "DB_Global".Out.MainRun := FALSE;
            "DB_Global".Out.MainSpeedPct := 0.0;
        END_IF;
    ELSIF "DB_Global".Machine.ManualActive AND "DB_Global".Out.MainRun THEN
        "DB_Global".Out.MainSpeedPct := JogSpeedPct;
    ELSE
        "DB_Global".Out.MainRun := FALSE;
        "DB_Global".Out.MainSpeedPct := 0.0;
    END_IF;

    "DB_Global".Out.GateOpen := GateFinalOpenCmd;
    "DB_Global".Out.GateClose := GateFinalCloseCmd;

    ExternalBottleWash(
        ProductionMode := "DB_Global".Machine.ProductionActive,
        MachineRunning := "DB_Global".Out.MainRun,
        ManualMode := "DB_Global".Machine.ManualActive,
        JogActive := "DB_Global".Cmd.JogPB AND "DB_Global".Out.MainRun,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CIPActive := "DB_Global".Machine.CIPActive,
        BottleCount := "DB_Global".Inp.BottleCountInMachine,
        OffDelay := "DB_Global".Par.ExternalWashOffDelay,
        ValveCmd => "DB_Global".Out.ExternalBottleWashValveCmd
    );

    InternalWash(
        OnCmd := "DB_Global".Cmd.InternalWashOn,
        OffCmd := "DB_Global".Cmd.InternalWashOff,
        ProductionMode := "DB_Global".Machine.ProductionActive,
        ManualMode := "DB_Global".Machine.ManualActive,
        CIPActive := "DB_Global".Machine.CIPActive,
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        CriticalAlarm := "DB_Global".AlarmCritical,
        SMCCommOK := "DB_Global".Inp.SMCCommOK,
        S := "DB_Global".InternalWash,
        ValveCmd => "DB_Global".Out.InternalWashValveCmd
    );

    ValveManager(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        CommOK := "DB_Global".Inp.SMCCommOK,
        OutputsPermitted := NOT "DB_Global".Machine.AlarmStopActive
                            AND NOT "DB_Global".Machine.DoorAccessActive,
        GateOpenCmd := GateFinalOpenCmd,
        GateCloseCmd := GateFinalCloseCmd,
        ProductInletCmd := "DB_Global".Out.ProductPumpRun,
        ProductCloseCmd := NOT "DB_Global".Out.ProductPumpRun,
        EV210Cmd := "DB_Global".Out.EV210,
        EV211Cmd := "DB_Global".Out.EV211,
        EV212Cmd := "DB_Global".Out.EV212,
        CapDistributorAir := "DB_Global".Inp.CapChannelDemand,
        CapChannelAir := "DB_Global".Inp.CapChannelDemand,
        SpareCmd := "DB_Global".Out.ExternalBottleWashValveCmd,
        ValveBits => "DB_Global".Out.ValveBits,
        ConflictAlarm => SMCConflict
    );

    // One-second machine efficiency counters. The state-machine and final
    // interlocked MainRun command remain the single authority for classification.
    EfficiencyPulse(CLK := "DB_Global".Inp.Blink1Hz);
    IF EfficiencyPulse.Q THEN
        "DB_Global".Efficiency.TotalSeconds := "DB_Global".Efficiency.TotalSeconds + 1;
        IF "DB_Global".AlarmCritical THEN
            "DB_Global".Efficiency.BreakdownSeconds := "DB_Global".Efficiency.BreakdownSeconds + 1;
        ELSIF "DB_Global".Out.MainRun THEN
            "DB_Global".Efficiency.RunSeconds := "DB_Global".Efficiency.RunSeconds + 1;
        ELSIF "DB_Global".Machine.StandbyActive THEN
            "DB_Global".Efficiency.WaitingSeconds := "DB_Global".Efficiency.WaitingSeconds + 1;
        ELSE
            "DB_Global".Efficiency.StopSeconds := "DB_Global".Efficiency.StopSeconds + 1;
        END_IF;
    END_IF;

    // Final cyclic open-point supervisor. It can only reduce permission or
    // force a safe output state; it never invents a physical address/mapping.
    OpenPointsSupervisor(
        SafetyOK := "DB_Global".Inp.SafetyOK,
        AirPressureOK := "DB_Global".Inp.AirPressureOK,
        EncoderHealthy := "DB_Global".Inp.EncoderHealthy,
        MachineZero := "DB_Global".Inp.MachineZero,
        EncoderCount := "DB_Global".Inp.EncoderCount,
        MachineStopped := MachineStopped,
        HomeStart := EffectiveCmd.HomeStart,
        Reset := EffectiveCmd.Reset,
        ProductionActive := "DB_Global".Machine.ProductionActive,
        MachineState := "DB_Global".Machine.State,
        BottleInfeed := "DB_Global".Inp.BottleInfeed,
        MainReady := "DB_Global".Inp.MainDriveReady,
        MainFault := "DB_Global".Inp.MainDriveFault,
        ProductPumpReady := "DB_Global".Inp.ProductPumpReady,
        ProductPumpFault := "DB_Global".Inp.ProductPumpFault,
        ConveyorReady := "DB_Global".Inp.ConveyorReady,
        ConveyorFault := "DB_Global".Inp.ConveyorFault,
        CapDriveReady := "DB_Global".Inp.CapDriveReady,
        CapDriveFault := "DB_Global".Inp.CapDriveFault,
        DriveNetworkOK := "DB_Global".Inp.DriveG120CNetworkOK,
        AnybusProfinetOK := "DB_Global".Inp.AnybusGatewayOK,
        AnybusEtherCATOK := "DB_Global".Inp.AnybusGatewayECATOK,
        SmcCommOK := "DB_Global".Inp.SMCCommOK,
        PilzCommOK := "DB_Global".Inp.PilzDeviceOK,
        AL100CommOK := "DB_Global".Inp.IOLinkMaster1OK,
        AL101CommOK := "DB_Global".Inp.IOLinkMaster2OK,
        AL102CommOK := "DB_Global".Inp.IOLinkMaster3OK,
        AL103CommOK := "DB_Global".Inp.IOLinkMaster4OK,
        AL104CommOK := "DB_Global".Inp.IOLinkMaster5OK,
        GateOpenFeedback := "DB_Global".Inp.GateOpenFB,
        GateClosedFeedback := "DB_Global".Inp.GateClosedFB,
        CapPresent := "DB_Global".Inp.CapPresent,
        CapHopperLow := "DB_Global".Inp.CapHopperLow,
        CapChannelDemand := "DB_Global".Inp.CapChannelDemand,
        CapsMissing := "DB_Global".Inp.CapsMissing,
        O := "DB_Global".OpenPoints,
        M := "DB_Global".Machine,
        Out := "DB_Global".Out
    );
END_FUNCTION_BLOCK
