TYPE "UDT_IOLinkPortMapping" :
STRUCT
    Configured          : Bool;       // TRUE only after TIA hardware/port commissioning
    QualityOK           : Bool;       // Verified port/device quality
    DeviceFault         : Bool;       // Verified device/port diagnostic fault
    LiveBool            : Bool;       // Logical digital state where applicable
    LiveReal            : Real;       // Logical process value where applicable
END_STRUCT;
END_TYPE

TYPE "UDT_IOLinkMasterMapping" :
STRUCT
    CommunicationOK     : Bool;       // Verified AL1403 PROFINET communication
    HardwareConfigured  : Bool;       // FALSE until the real AL1403 exists in TIA HW
    Port                : Array[1..8] of "UDT_IOLinkPortMapping";
END_STRUCT;
END_TYPE

TYPE "UDT_PilzDiagnostic" :
STRUCT
    // REV23 non-safety diagnostic interface only. The Pilz controller remains
    // the sole safety authority. No member of this structure commands or
    // bypasses a safety function.
    CommunicationOK       : Bool; // Existing aggregate PROFINET/station health
    DataValid             : Bool; // FALSE means every dependent value is invalid
    PhysicalMapConfigured : Bool; // Held FALSE until GSDML/process map is proven
    SafetyReady           : Bool; // Aggregate, valid only while DataValid = TRUE
    GeneralFault          : Bool; // Aggregate, valid only while DataValid = TRUE
    ResetRequired         : Bool; // Standard diagnostic indication only
    EStopChainHealthy     : Bool; // Aggregate chain; no individual device identity
    AllGuardsClosed       : Bool; // Aggregate status for all 11 doors
    AllGuardsUnlocked     : Bool; // Aggregate status; locking topology unverified
    SafetyCircuitClosed   : Bool; // Aggregate closed safety-circuit indication
    StandstillConfirmed   : Bool; // Aggregate zero-speed indication
    ThreePhaseOffConfirmed: Bool; // Aggregate power-off indication
END_STRUCT;
END_TYPE

TYPE "UDT_Machine" :
STRUCT
    State               : USInt;
