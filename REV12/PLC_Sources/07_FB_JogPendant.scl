FUNCTION_BLOCK "FB_JogPendant"
VAR_INPUT
    ManualMode          : Bool;
    SafetyOK            : Bool;
    PendantConnected    : Bool;
    JogPB               : Bool;
    HeightModeActive    : Bool;
    MainDriveReady      : Bool;
    JogSpeedPct         : Real;
    RecoveryComplete    : Bool;
END_VAR
VAR_IN_OUT
    TrackingValid       : Bool;
END_VAR
VAR_OUTPUT
    JogForwardCmd       : Bool;
    SpeedRefPct         : Real;
END_VAR

BEGIN
    // The machine is mechanically forward-only. No reverse command exists.
    JogForwardCmd :=
        ManualMode
        AND SafetyOK
        AND PendantConnected
        AND JogPB
        AND NOT HeightModeActive
        AND MainDriveReady;

    IF JogForwardCmd THEN
        SpeedRefPct := JogSpeedPct;
        TrackingValid := FALSE; // latched invalid until recovery/homing
    ELSE
        SpeedRefPct := 0.0;
    END_IF;

    IF RecoveryComplete THEN
        TrackingValid := TRUE;
    END_IF;
END_FUNCTION_BLOCK
