FUNCTION_BLOCK "FB_ProductPump"
VAR_INPUT
    Enable              : Bool;
    ManualMode          : Bool;
    EmptyingMode        : Bool;
    DriveReady          : Bool;
    DriveFault          : Bool;
    LevelPct            : Real;
    SetpointPct         : Real;
    DeadbandPct         : Real;
    MinSpeedPct         : Real;
    MaxSpeedPct         : Real;
    RampPctPerCycle     : Real;
    ManualFrequencyHz   : Real;
    ManualMinHz         : Real;
    ManualMaxHz         : Real;
    DriveBaseFrequencyHz: Real;
END_VAR
VAR_OUTPUT
    RunCmd              : Bool;
    SpeedRefPct         : Real := 0.0;
    FrequencyRefHz      : Real := 0.0;
    LevelSignalFault    : Bool;
    LowLevelWarning     : Bool;
END_VAR
VAR
    TargetSpeed         : Real;
    ErrorPct            : Real;
    SpeedMemory         : Real := 0.0;
END_VAR

BEGIN
    LevelSignalFault := (LevelPct < -1.0) OR (LevelPct > 101.0);
    LowLevelWarning := (LevelPct < 5.0) AND NOT EmptyingMode;

    RunCmd := Enable AND DriveReady AND NOT DriveFault AND NOT LevelSignalFault;

    IF NOT RunCmd THEN
        TargetSpeed := 0.0;
    ELSIF ManualMode THEN
        // REV01 manual product-pump baseline: 15..40 Hz, still subject to
        // product-presence/dry-run protection in the caller.
        IF DriveBaseFrequencyHz > 0.0 THEN
            TargetSpeed := (LIMIT(MN := ManualMinHz,
                                  IN := ManualFrequencyHz,
                                  MX := ManualMaxHz) / DriveBaseFrequencyHz) * 100.0;
        ELSE
            TargetSpeed := 0.0;
        END_IF;
    ELSE
        ErrorPct := SetpointPct - LevelPct;

        // Below setpoint: progressively increase speed.
        IF ErrorPct > DeadbandPct THEN
            TargetSpeed := MinSpeedPct +
                ((MaxSpeedPct - MinSpeedPct) * ErrorPct / 20.0);

        // Inside deadband: maintain only the minimum continuous-flow speed.
        ELSIF ABS(ErrorPct) <= DeadbandPct THEN
            TargetSpeed := MinSpeedPct;

        // Above setpoint: stop normal filling pump. This corrects REV10 overfill behavior.
        ELSE
            TargetSpeed := 0.0;
        END_IF;

        IF EmptyingMode THEN
            TargetSpeed := MaxSpeedPct;
        END_IF;

        TargetSpeed := LIMIT(MN := 0.0, IN := TargetSpeed, MX := MaxSpeedPct);
    END_IF;

    // Simple parameterized ramp.
    IF SpeedMemory < TargetSpeed THEN
        SpeedMemory := MIN(IN1 := SpeedMemory + RampPctPerCycle, IN2 := TargetSpeed);
    ELSIF SpeedMemory > TargetSpeed THEN
        SpeedMemory := MAX(IN1 := SpeedMemory - RampPctPerCycle, IN2 := TargetSpeed);
    END_IF;

    // Drive the output every scan; the retained ramp state is held internally.
    SpeedRefPct := SpeedMemory;
    IF DriveBaseFrequencyHz > 0.0 THEN
        FrequencyRefHz := (SpeedMemory / 100.0) * DriveBaseFrequencyHz;
    ELSE
        FrequencyRefHz := 0.0;
    END_IF;
END_FUNCTION_BLOCK
