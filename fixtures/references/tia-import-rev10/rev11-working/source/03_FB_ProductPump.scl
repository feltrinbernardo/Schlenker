FUNCTION_BLOCK "FB_ProductPump"
VAR_INPUT
    Enable           : Bool;
    EmptyingMode     : Bool;
    LevelPct         : Real;
    SetpointPct      : Real; // HMI 10..100%
    DeadbandPct      : Real;
    MinSpeedPct      : Real;
    MaxSpeedPct      : Real;
    DryRunActive     : Bool;
    DriveReady       : Bool;
    DriveFault       : Bool;
END_VAR
VAR_OUTPUT
    RunCmd            : Bool;
    SpeedRefPct       : Real;
    LowLevelAlarm     : Bool;
    SensorAlarm       : Bool;
END_VAR
VAR
    ErrorPct          : Real;
END_VAR

BEGIN
    SensorAlarm := (LevelPct < -1.0) OR (LevelPct > 101.0);
    LowLevelAlarm := (LevelPct < 5.0) AND NOT EmptyingMode;

    RunCmd := Enable
              AND DriveReady
              AND NOT DriveFault
              AND NOT DryRunActive
              AND NOT SensorAlarm;

    IF NOT RunCmd THEN
        SpeedRefPct := 0.0;
    ELSE
        ErrorPct := SetpointPct - LevelPct;

        IF ABS(ErrorPct) <= DeadbandPct THEN
            SpeedRefPct := MinSpeedPct;
        ELSIF ErrorPct > 0.0 THEN
            SpeedRefPct := MinSpeedPct +
                ((MaxSpeedPct - MinSpeedPct) * ErrorPct / 20.0);
        ELSE
            SpeedRefPct := MinSpeedPct;
        END_IF;

        IF SpeedRefPct > MaxSpeedPct THEN
            SpeedRefPct := MaxSpeedPct;
        END_IF;
        IF SpeedRefPct < 0.0 THEN
            SpeedRefPct := 0.0;
        END_IF;
    END_IF;
END_FUNCTION_BLOCK
