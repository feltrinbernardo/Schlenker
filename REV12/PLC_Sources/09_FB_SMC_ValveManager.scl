FUNCTION_BLOCK "FB_SMC_ValveManager"
VAR_INPUT
    SafetyOK            : Bool;
    CommOK              : Bool;
    OutputsPermitted    : Bool;
    GateOpenCmd         : Bool;
    GateCloseCmd        : Bool;
    ProductInletCmd     : Bool;
    ProductCloseCmd     : Bool;
    EV210Cmd            : Bool;
    EV211Cmd            : Bool;
    EV212Cmd            : Bool;
    CapDistributorAir   : Bool;
    CapChannelAir       : Bool;
    SpareCmd            : Bool;
END_VAR
VAR_OUTPUT
    ValveBits           : DWORD;
    ConflictAlarm       : Bool;
END_VAR

BEGIN
    ValveBits := DWORD#0;
    ConflictAlarm := (GateOpenCmd AND GateCloseCmd) OR (ProductInletCmd AND ProductCloseCmd);

    IF SafetyOK AND CommOK AND OutputsPermitted AND NOT ConflictAlarm THEN
        ValveBits.%X0 := GateOpenCmd;
        ValveBits.%X1 := GateCloseCmd;
        ValveBits.%X2 := ProductInletCmd;
        ValveBits.%X3 := ProductCloseCmd;
        ValveBits.%X4 := EV210Cmd;
        ValveBits.%X5 := EV211Cmd;
        ValveBits.%X6 := EV212Cmd;
        ValveBits.%X7 := CapDistributorAir;
        ValveBits.%X8 := CapChannelAir;
        ValveBits.%X9 := SpareCmd;
    END_IF;
END_FUNCTION_BLOCK
