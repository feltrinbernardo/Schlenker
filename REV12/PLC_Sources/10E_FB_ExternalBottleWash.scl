FUNCTION_BLOCK "FB_ExternalBottleWash"
VAR_INPUT
    ProductionMode     : Bool;
    MachineRunning     : Bool;
    ManualMode         : Bool;
    JogActive          : Bool;
    SafetyOK           : Bool;
    CIPActive          : Bool;
    BottleCount        : DInt;
    OffDelay           : Time;
END_VAR
VAR_OUTPUT
    ValveCmd           : Bool;
    Active             : Bool;
END_VAR
VAR
    OffDelayTimer      : TOF;
    OpenRequest        : Bool;
END_VAR
BEGIN
    OpenRequest := (BottleCount > 0)
                   AND ((ProductionMode AND MachineRunning)
                        OR (ManualMode AND JogActive));

    OffDelayTimer(IN := OpenRequest, PT := OffDelay);
    Active := OffDelayTimer.Q;

    // Safety loss and CIP always close immediately; the delay only covers
    // normal RUN/bottle-count removal.
    ValveCmd := Active AND SafetyOK AND NOT CIPActive;
END_FUNCTION_BLOCK
