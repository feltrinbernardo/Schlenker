FUNCTION_BLOCK "FB_ManualValveOverride"
VAR_INPUT
    ManualMode       : Bool;
    MenuActive       : Bool;
    SafetyOK         : Bool;
    ManualTestEnable : Bool;
    OpenPB           : Bool;
    ClosePB          : Bool;
    AutoOpenCmd      : Bool;
    AutoCloseCmd     : Bool;
END_VAR
VAR_OUTPUT
    OpenCmd          : Bool;
    CloseCmd         : Bool;
    TestModeActive   : Bool;
END_VAR
BEGIN
    TestModeActive := ManualMode
                      AND MenuActive
                      AND SafetyOK
                      AND ManualTestEnable;

    IF NOT SafetyOK THEN
        OpenCmd := FALSE;
        CloseCmd := FALSE;
    ELSIF TestModeActive THEN
        OpenCmd := OpenPB AND NOT ClosePB;
        CloseCmd := ClosePB AND NOT OpenPB;
    ELSE
        // Leaving Manual or the HMI page returns to automatic in this scan.
        OpenCmd := AutoOpenCmd;
        CloseCmd := AutoCloseCmd;
    END_IF;
END_FUNCTION_BLOCK
